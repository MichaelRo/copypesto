    "Your Home Screen icon follows the theme when you leave Settings. iOS asks to confirm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Home Screen icon follows the theme when you leave Settings. iOS asks to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono de la pantalla de inicio sigue al tema al salir de Ajustes. iOS pide confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône de l’écran d’accueil suit le thème quand vous quittez les réglages. iOS demande confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol auf dem Home-Bildschirm folgt dem Thema, sobald du die Einstellungen verlässt. iOS fragt nach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を閉じると、ホーム画面のアイコンがテーマに合わせて変わります。iOSが確認を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开设置时，主屏幕图标会跟随主题。iOS 会请求确认。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone na Tela de Início segue o tema quando você sai dos Ajustes. O iOS pede confirmação."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסמל במסך הבית עוקב אחרי ערכת הנושא כשיוצאים מההגדרות. iOS מבקש אישור."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок на экране «Домой» меняется под тему, когда вы выходите из настроек. iOS попросит подтвердить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок на початковому екрані змінюється під тему, щойно ви виходите з параметрів. iOS попросить підтвердити."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 나가면 홈 화면 아이콘이 테마를 따릅니다. iOS가 확인을 요청합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icona nella schermata Home segue il tema quando esci dalle impostazioni. iOS chiede conferma."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona na ploše se po odchodu z nastavení přizpůsobí motivu. iOS požádá o potvrzení."
          }
        }
      }
    },
    "The icon in the Dock follows the theme.": {
