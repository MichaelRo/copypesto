    "Clips are hidden while the screen is recorded or shared.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips are hidden while the screen is recorded or shared."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výstřižky jsou při nahrávání nebo sdílení obrazovky skryté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips sind ausgeblendet, während der Bildschirm aufgenommen oder geteilt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recortes se ocultan mientras se graba o comparte la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits sont masqués pendant l’enregistrement ou le partage de l’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגזירים מוסתרים בזמן הקלטה או שיתוף מסך."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ritagli sono nascosti durante la registrazione o la condivisione dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の収録中または共有中はクリップが非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 기록하거나 공유하는 동안 클립이 가려집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recortes ficam ocultos enquanto a tela está sendo gravada ou compartilhada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменты скрыты во время записи или демонстрации экрана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагменти приховані під час запису або спільного доступу до екрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制或共享屏幕时将隐藏剪辑。"
          }
        }
      }
    },
