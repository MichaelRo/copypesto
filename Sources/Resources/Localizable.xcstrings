    "This deletes every clip that is not pinned. It can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every clip that is not pinned. It can’t be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle nicht angehefteten Clips gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los clips que no están fijados. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les clips non épinglés. C’est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת כל קטע שאינו מוצמד. לא ניתן לבטל אותה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされていないすべてのクリップを削除します。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga todos os clipes que não estão fixados. Essa ação não pode ser desfeita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有未固定的剪贴，且不可撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся все незакреплённые записи. Это действие необратимо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить усі незакріплені кліпи. Дію не можна скасувати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정되지 않은 모든 클립을 삭제해요. 실행 취소할 수 없어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina tutti i clip non fissati. L'operazione non è annullabile."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se smažou všechny nepřipnuté klipy. Tuto akci nelze vrátit."
          }
        }
      }
    },
    "This device has no passcode, so Pesto can’t ask who you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no passcode, so Pesto can’t ask who you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist kein Code eingerichtet, daher kann Pesto dich nicht authentifizieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene código, así que Pesto no puede verificar tu identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de code ; Pesto ne peut donc pas vérifier votre identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במכשיר הזה אין קוד גישה, ולכן Pesto לא יכולה לאמת את זהותך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはパスコードが設定されていないため、本人確認ができません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem código, então o Pesto não tem como confirmar sua identidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未设置密码，因此 Pesto 无法验证你的身份。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве не задан код-пароль, поэтому Pesto не может запросить проверку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої немає коду допуску, тому Pesto не може перевірити вашу особу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 암호가 설정되어 있지 않아 본인 확인을 요청할 수 없어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha un codice, quindi Pesto non può verificare la tua identità."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nemá nastavený přístupový kód, takže Pesto nemůže ověřit vaši totožnost."
          }
        }
      }
    },
