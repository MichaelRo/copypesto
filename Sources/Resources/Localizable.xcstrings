            "value": "使用 {{date}} 等占位符或提问字段，或从任意剪贴的菜单中存为片段。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use campos como {{date}} ou perguntas, ou salve qualquer clipe como trecho pelo menu dele."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו במצייני מיקום כמו {{date}} או בשאלות למילוי, או שמרו כל קטע כקטע טקסט מהתפריט שלו."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте заполнители вроде {{date}} и вопросы или сохраните любую запись как сниппет из её меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте заповнювачі на кшталт {{date}} чи запитання, або збережіть будь-який кліп як сніпет через його меню."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{date}} 같은 자리 표시자나 입력 질문을 사용하거나 클립 메뉴에서 스니펫으로 저장하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa segnaposto come {{date}} o domande, oppure salva un clip come frammento dal suo menu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte zástupné symboly jako {{date}} nebo otázky, případně uložte klip jako úryvek z jeho nabídky."
          }
        }
      }
    },
