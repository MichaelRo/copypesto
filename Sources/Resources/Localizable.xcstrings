          }
        }
      }
    },
    "Pesto could not open its history. Restart Pesto to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto could not open its history. Restart Pesto to try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto konnte seinen Verlauf nicht öffnen. Starte Pesto neu und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto no pudo abrir su historial. Reinicia Pesto para intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto n’a pas pu ouvrir son historique. Redémarrez Pesto pour réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto לא הצליחה לפתוח את ההיסטוריה שלה. הפעילו מחדש את Pesto כדי לנסות שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoで履歴を開けませんでした。再起動してやり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto não conseguiu abrir o histórico. Reinicie o Pesto para tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto 无法打开历史记录，请重启 Pesto 后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto не удалось открыть историю. Перезапустите приложение и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto не вдалося відкрити історію. Перезапустіть Pesto, щоб спробувати ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto가 기록을 열지 못했어요. Pesto를 재시작해 다시 시도해 주세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto non è riuscito ad aprire la cronologia. Riavvia Pesto per riprovare."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestu se nepodařilo otevřít historii. Restartujte ho a zkuste to znovu."
          }
        }
      }
    },
