    "Resets what Pesto has suggested and re-arms all suggestions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets what Pesto has suggested and re-arms all suggestions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt zurück, was Pesto vorgeschlagen hat, und aktiviert alle Vorschläge wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece lo que Pesto ha sugerido y vuelve a activar todas las sugerencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialise ce que Pesto a suggéré et réactive toutes les suggestions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפס את מה ש-Pesto הציעה ומפעיל מחדש את כל ההצעות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoの提案履歴をリセットし、すべての提案を再び有効にします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefine o que o Pesto sugeriu e reativa todas as sugestões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置 Pesto 提出过的建议，并重新启用所有建议。"
          }
        }
      }
    },
    "Suggestions are off. Turn them back on in Settings, under General.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions are off. Turn them back on in Settings, under General."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge sind deaktiviert. Aktiviere sie wieder in den Einstellungen unter „Allgemein“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias están desactivadas. Vuelve a activarlas en Ajustes, en General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions sont désactivées. Réactivez-les dans Réglages, sous Général."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההצעות כבויות. אפשר להפעיל אותן מחדש בהגדרות, תחת ״כללי״."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案はオフです。「設定」の「一般」から再びオンにできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
