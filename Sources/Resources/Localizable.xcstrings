    "Reduce Transparency is on in System Settings, so the shelf is solid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Transparency is on in System Settings, so the shelf is solid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Transparenz reduzieren“ ist in den Systemeinstellungen aktiv, daher ist die Ablage deckend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir transparencia está activado en Ajustes del Sistema, así que el estante es sólido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réduire la transparence » est activé dans Réglages Système ; l’étagère reste donc unie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״הפחתת שקיפות״ פעילה בהגדרות המערכת, ולכן המדף אטום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で「透明度を下げる」がオンのため、シェルフはソリッド表示です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir Transparência está ativado nos Ajustes do Sistema, então a prateleira fica sólida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置中已开启“降低透明度”，因此剪贴架采用纯色外观。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Системных настройках включено «Уменьшение прозрачности», поэтому полка непрозрачная."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Системних параметрах увімкнено «Зменшення прозорості», тому полиця непрозора."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 ‘투명도 줄이기’가 켜져 있어 셸프가 단색으로 표시돼요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci trasparenza è attivo in Impostazioni di Sistema, quindi lo scaffale è opaco."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Nastavení systému je zapnuto Snížit průhlednost, takže polička má plné pozadí."
          }
        }
      }
    },
