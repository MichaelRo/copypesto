    "Paste fills the clipboard placeholder. Without it, that placeholder stays empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste fills the clipboard placeholder. Without it, that placeholder stays empty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einsetzen füllt den Zwischenablage-Platzhalter. Ohne bleibt er leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar rellena el marcador del portapapeles. Si no, ese marcador queda vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller remplit le champ presse-papiers. Sinon, ce champ reste vide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבקה ממלאת את מציין המיקום של הלוח. בלעדיה, מציין המיקום הזה נשאר ריק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペーストするとクリップボードのプレースホルダが埋まります。空の場合は何も入りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colar preenche o campo da área de transferência. Sem isso, esse campo fica vazio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴权限用于填入剪贴板占位符。若不授予，该占位符将保持为空。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставка заполняет заполнитель буфера обмена. Без неё он останется пустым."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставлення заповнює заповнювач буфера обміну. Без нього він залишається порожнім."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣으면 클립보드 자리 표시자가 채워져요. 없으면 해당 자리는 비어 있게 돼요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla compila il segnaposto degli appunti. Senza, quel segnaposto resta vuoto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložit vyplní zástupný symbol schránky. Bez něj zůstane prázdný."
          }
        }
      }
    },
