    "Add a question or a fill, like {{date}}, so Pesto can fill it in when you paste.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a question or a fill, like {{date}}, so Pesto can fill it in when you paste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Frage oder ein Feld wie {{date}} hinzu, damit Pesto es beim Einsetzen ausfüllt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una pregunta o un campo, como {{date}}, para que Pesto lo rellene al pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une question ou un champ, comme {{date}}, pour que Pesto le remplisse au collage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו שאלה או שדה מילוי, כמו {{date}}, כדי ש-Pesto תמלא אותם בזמן ההדבקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問や {{date}} のような入力項目を追加すると、ペースト時にPestoが入力します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma pergunta ou um campo, como {{date}}, para o Pesto preencher ao colar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加问题或填充项（如 {{date}}），这样 Pesto 会在粘贴时为你填入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте вопрос или автоподстановку, например {{date}}, чтобы Pesto заполнял их при вставке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте запитання або заповнювач на кшталт {{date}}, щоб Pesto підставляв дані під час вставлення."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣을 때 Pesto가 대신 입력할 수 있도록 질문이나 {{date}} 같은 채우기 항목을 추가하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una domanda o un campo automatico, come {{date}}, per farlo compilare da Pesto quando incolli."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte otázku nebo pole, třeba {{date}}, aby je Pesto při vložení doplnilo."
          }
        }
      }
    },
