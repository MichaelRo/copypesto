    "A copy stays on this device and leaves the clipboard after two minutes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy stays on this device and leaves the clipboard after two minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie bleibt auf diesem Gerät und wird nach zwei Minuten aus der Zwischenablage entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia se queda en este dispositivo y se borra del portapapeles a los dos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie reste sur cet appareil et est effacée du presse-papiers après deux minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק נשאר במכשיר זה ונמחק מהלוח לאחר שתי דקות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーはこのデバイスにとどまり、2分後にクリップボードから消去されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia fica neste dispositivo e sai da área de transferência após dois minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝内容仅留在此设备上，并在两分钟后从剪贴板清除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия остаётся на этом устройстве и исчезает из буфера обмена через две минуты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія залишається на цьому пристрої й зникає з буфера обміну за дві хвилини."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 항목은 이 기기에만 남고 2분 뒤 클립보드에서 비워져요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia resta su questo dispositivo e scompare dagli appunti dopo due minuti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zůstane na tomto zařízení a po dvou minutách zmizí ze schránky."
          }
        }
      }
    },
