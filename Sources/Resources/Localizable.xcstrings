    "A plain collection holds the clips you add. A smart one fills itself from rules.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plain collection holds the clips you add. A smart one fills itself from rules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine normale Sammlung enthält die Clips, die du hinzufügst. Eine intelligente füllt sich anhand von Regeln selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una colección simple guarda los clips que añades. Una inteligente se llena sola con reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une collection simple contient les clips que vous ajoutez. Une collection intelligente se remplit seule selon des règles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוסף רגיל שומר את הקטעים שמוסיפים אליו. אוסף חכם מתמלא מעצמו לפי כללים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のコレクションには追加したクリップが入ります。スマートコレクションはルールに従って自動で集まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma coleção simples guarda os clipes que você adiciona. Uma inteligente se preenche sozinha por regras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通合集保存你手动添加的剪贴，智能合集则根据规则自动收集。"
