    "To show your clips, allow Full Access in Settings > General > Keyboard > Keyboards > Pesto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show your clips, allow Full Access in Settings > General > Keyboard > Keyboards > Pesto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar tus clips, activa Permitir acceso completo en Ajustes > General > Teclado > Teclados > Pesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher vos clips, autorisez l’accès complet dans Réglages > Général > Clavier > Claviers > Pesto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Clips anzuzeigen, erlaube den vollen Zugriff unter Einstellungen > Allgemein > Tastatur > Tastaturen > Pesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを表示するには、「設定」>「一般」>「キーボード」>「キーボード」>「Pesto」でフルアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要显示你的剪辑，请在“设置”>“通用”>“键盘”>“键盘”>“Pesto”中允许完全访问。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar seus clipes, permita o Acesso Total em Ajustes > Geral > Teclado > Teclados > Pesto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להציג את הקטעים שלך, יש לאפשר גישה מלאה בהגדרות > כללי > מקלדת > מקלדות > Pesto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы показывать клипы, разрешите полный доступ в Настройках > Основные > Клавиатура > Клавиатуры > Pesto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб показувати кліпи, дозвольте повний доступ у Параметрах > Загальні > Клавіатура > Клавіатури > Pesto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 표시하려면 설정 > 일반 > 키보드 > 키보드 > Pesto에서 전체 접근을 허용하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mostrare i tuoi clip, consenti l’accesso completo in Impostazioni > Generali > Tastiera > Tastiere > Pesto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zobrazit své klipy, povolte úplný přístup v Nastavení > Obecné > Klávesnice > Klávesnice > Pesto."
          }
        }
      }
    },
    "Turn on Insert from Pesto in other apps in Pesto's Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Insert from Pesto in other apps in Pesto's Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Insertar desde Pesto en otras apps en los Ajustes de Pesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Insérer depuis Pesto dans d’autres apps dans les réglages de Pesto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Aus Pesto in anderen Apps einfügen“ in den Pesto-Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoの設定で「他のアプリでPestoから挿入」をオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Pesto 设置中打开“在其他 App 中从 Pesto 插入”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Inserir do Pesto em outros apps nos Ajustes do Pesto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל ״הכנס מ-Pesto ביישומים אחרים״ בהגדרות של Pesto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Вставка из Pesto в других приложениях» в настройках Pesto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть «Вставляти з Pesto в інших програмах» у налаштуваннях Pesto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto 설정에서 ‘다른 앱에서 Pesto 항목 삽입’을 켜세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Inserisci da Pesto in altre app nelle Impostazioni di Pesto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Vkládat z Pesta v jiných aplikacích v Nastavení Pesta."
          }
        }
      }
    },
    "No text clips yet. Clips with secrets never appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text clips yet. Clips with secrets never appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay clips de texto. Los clips con secretos nunca aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun clip texte pour l’instant. Les clips contenant des secrets n’apparaissent jamais ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Textclips. Clips mit Geheimnissen erscheinen hier nie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストクリップはまだありません。シークレットを含むクリップはここには表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无文本剪辑。包含敏感信息的剪辑不会显示在这里。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há clipes de texto. Clipes com segredos nunca aparecem aqui."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין קטעי טקסט. קטעים עם סודות לעולם אינם מופיעים כאן."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстовых клипов пока нет. Клипы с секретами здесь никогда не появляются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстових кліпів ще немає. Кліпи із секретами тут ніколи не з’являються."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 텍스트 클립이 없습니다. 비밀 정보가 포함된 클립은 여기에 표시되지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun clip di testo. I clip con dati riservati non appaiono mai qui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné textové klipy. Klipy s citlivými údaji se zde nikdy nezobrazují."
          }
        }
      }
    },
