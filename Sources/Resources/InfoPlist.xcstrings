    "NSAccessibilityUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto uses Accessibility to paste clips directly into the app you were using, and to notice a double ⌘C."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto usa Accesibilidad para pegar clips directamente en la app que estabas usando y para detectar una doble pulsación de ⌘C."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto utilise l’Accessibilité pour coller des clips directement dans l’app que vous utilisez et pour détecter un double ⌘C."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto nutzt die Bedienungshilfen, um Clips direkt in die aktive App einzufügen und ein doppeltes ⌘C zu erkennen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoはアクセシビリティを使って、使用中のアプリにクリップを直接ペーストし、⌘Cの2回押しを検出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto 使用辅助功能将剪贴内容直接粘贴到你正在使用的 App 中，并检测双击 ⌘C。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto usa a Acessibilidade para colar clipes diretamente no app em uso e para detectar um toque duplo em ⌘C."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto משתמשת בנגישות כדי להדביק קטעים ישירות ליישום שבו השתמשת וכדי לזהות לחיצה כפולה על ⌘C."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto asks for Face ID before it shows your clips when the History Lock is on, and before it shows a hidden clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto pide Face ID antes de mostrar tus clips cuando el bloqueo de historial está activo y antes de mostrar un clip oculto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto demande Face ID avant d’afficher vos clips lorsque le verrouillage de l’historique est activé, ainsi qu’avant d’afficher un clip masqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto fragt nach Face ID, bevor bei aktiver Verlaufssperre Clips oder ein ausgeblendeter Clip angezeigt werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴ロックがオンのときにクリップを表示する前、および非表示のクリップを表示する前にFace IDを求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当历史记录锁定开启时，或显示隐藏的剪贴内容前，Pesto 会请求面容 ID 验证。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto solicita o Face ID antes de mostrar seus clipes quando o Bloqueio de Histórico está ativado e antes de exibir um clipe oculto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto מבקשת אימות Face ID לפני הצגת הקטעים שלך כשנעילת ההיסטוריה פעילה, ולפני הצגת קטע מוסתר."
          }
        }
      }
    },
