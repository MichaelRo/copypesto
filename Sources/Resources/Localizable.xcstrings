    "Rebuilds the search index for text and code clips. It runs on this Mac; nothing is sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilds the search index for text and code clips. It runs on this Mac; nothing is sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baut den Suchindex für Text- und Code-Clips neu auf. Läuft lokal auf diesem Mac; nichts wird versendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruye el índice de búsqueda para clips de texto y código. Se ejecuta en este Mac; no se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruit l’index de recherche des clips de texte et de code. S’exécute sur ce Mac ; rien n’est envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בונה מחדש את אינדקס החיפוש עבור קטעי טקסט וקוד. פועל ב-Mac זה; שום דבר לא נשלח החוצה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストとコードクリップの検索インデックスを再構築します。このMac上だけで実行され、外部には何も送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstrói o índice de busca para clipes de texto e código. Roda neste Mac; nada é enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为文本和代码剪贴重建搜索索引。在此 Mac 上本地运行，不会发送任何数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перестраивает поисковый индекс для текста и кода. Всё работает на этом Mac; ничего не отправляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перебудовує пошуковий індекс для тексту й коду. Працює на цьому Mac; нічого не надсилається."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트와 코드 클립의 검색 색인을 다시 만들어요. 이 Mac에서만 실행되며 외부로 전송되는 것은 없어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricostruisce l'indice di ricerca per i clip di testo e codice. Gira su questo Mac; nulla viene inviato."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu sestaví index vyhledávání pro textové klipy a kód. Probíhá na tomto Macu, nic se neodesílá."
          }
        }
      }
    },
