    "Your clips are encrypted on this device. Only sync sends them, and only to your own folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clips are encrypted on this device. Only sync sends them, and only to your own folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus clips están cifrados en este dispositivo. Solo la sincronización los envía, y solo a tu propia carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos clips sont chiffrés sur cet appareil. Seule la synchronisation les envoie, et seulement vers votre propre dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Clips sind auf diesem Gerät verschlüsselt. Nur Sync sendet sie, und nur in deinen eigenen Ordner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップはこのデバイス上で暗号化されています。送信するのは同期だけで、送信先はあなた自身のフォルダだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的剪辑在此设备上加密。只有同步会发送它们，且只发送到你自己的文件夹。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus clips são criptografados neste dispositivo. Só a sincronização os envia, e só para a sua própria pasta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקליפים שלכם מוצפנים במכשיר הזה. רק הסנכרון שולח אותם, ורק לתיקייה שלכם."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши клипы зашифрованы на этом устройстве. Их отправляет только синхронизация и только в вашу собственную папку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші кліпи зашифровано на цьому пристрої. Їх надсилає лише синхронізація і лише до вашої власної папки."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립은 이 기기에서 암호화됩니다. 동기화만 클립을 보내며, 보내는 곳은 내 폴더뿐입니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi clip sono cifrati su questo dispositivo. Solo la sincronizzazione li invia, e solo nella tua cartella."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše klipy jsou na tomto zařízení šifrované. Odesílá je jen synchronizace, a to jen do vaší vlastní složky."
          }
        }
      }
    },
