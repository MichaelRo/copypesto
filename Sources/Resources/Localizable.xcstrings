    "Pesto notices clips you paste often and offers a shortcut, suggests snippets for repeated text, and tidies unused shortcuts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto notices clips you paste often and offers a shortcut, suggests snippets for repeated text, and tidies unused shortcuts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto erkennt häufig eingesetzte Clips und bietet einen Kurzbefehl an, schlägt Snippets für wiederholten Text vor und räumt ungenutzte Kurzbefehle auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto detecta los clips que pegas a menudo y te propone un atajo, sugiere fragmentos para texto repetido y limpia atajos sin usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto repère les clips que vous collez souvent et propose un raccourci, suggère des extraits pour le texte répété et range les raccourcis inutilisés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto מזהה קטעים שמדביקים לעיתים קרובות ומציעה קיצור, מציעה קטעים מוכנים לטקסט חוזר ומסדרת קיצורים לא פעילים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoはよくペーストするクリップにショートカットを提案し、繰り返すテキストにはスニペットを勧め、使われないショートカットを整理します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto percebe clipes que você cola com frequência e oferece um atalho, sugere snippets para textos repetidos e limpa atalhos sem uso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto 会留意你频繁粘贴的剪贴并提供快捷键，为重复文本推荐片段，并清理未使用的快捷键。"
          }
        }
      }
    },
