    "Encrypted on this Mac. Pesto sends no clips anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted on this Mac. Pesto sends no clips anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac verschlüsselt. Pesto sendet keine Clips nach außen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado en este Mac. Pesto no envía ningún clip a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré sur ce Mac. Pesto n’envoie vos clips nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצפן ב-Mac זה. Pesto לא שולחת קטעים לשום מקום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上で暗号化されます。Pestoがクリップを外部へ送信することはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografado neste Mac. O Pesto não envia clipes para lugar nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上加密，Pesto 不会将剪贴发送到任何地方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифровано на этом Mac. Pesto никуда не отправляет записи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифровано на цьому Mac. Pesto нікуди не надсилає кліпи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 직접 암호화돼요. Pesto는 클립을 어디로도 보내지 않아요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrato su questo Mac. Pesto non invia alcun clip."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrováno na tomto Macu. Pesto žádné klipy nikam neposílá."
          }
        }
      }
    },
