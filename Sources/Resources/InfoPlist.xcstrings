    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto saves a picture from your history to Photos when you choose Save to Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto guarda una imagen de tu historial en Fotos cuando eliges Guardar en Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto enregistre une image de votre historique dans Photos lorsque vous choisissez « Enregistrer dans Photos »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto speichert ein Bild aus deinem Verlauf in „Fotos“, wenn du „In Fotos sichern“ wählst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真に保存」を選んだときに、履歴の画像を「写真」アプリに保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你选择“保存到照片”时，Pesto 会将历史记录中的图片保存至“照片”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto salva uma imagem do seu histórico no Fotos quando você escolhe Salvar no Fotos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto שומרת תמונה מההיסטוריה שלך אל ״תמונות״ כשבוחרים ״שמירה בתמונות״."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto сохраняет изображения из истории в «Фото», когда вы выбираете «Сохранить в Фото»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto зберігає зображення з історії у «Фотографії», коли ви обираєте «Зберегти у Фотографії»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'사진에 저장'을 선택하면 Pesto가 기록의 이미지를 사진 앱에 저장합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto salva un'immagine dalla cronologia in Foto quando scegli Salva in Foto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto uloží obrázek z vaší historie do aplikace Fotky, když vyberete Uložit do Fotek."
          }
        }
      }
    }
  },
  "version": "1.0"
}
