    },
    "This deletes every clip that is not pinned. It can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes every clip that is not pinned. It can’t be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht alle nicht angehefteten Clips. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los clips que no están fijados. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci supprime tous les clips non épinglés. C’est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת כל קטע שאינו מוצמד. לא ניתן לבטל פעולה זו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされていないすべてのクリップを削除します。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga todos os clipes que não estão fixados. Não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有未置顶的剪贴。此操作不可撤销。"
          }
        }
      }
    },
    "This device has no passcode, so Pesto can’t ask who you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no passcode, so Pesto can’t ask who you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keinen Code, daher kann Pesto deine Identität nicht prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene código, así que Pesto no puede verificar tu identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de code ; Pesto ne peut donc pas vérifier votre identité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למכשיר זה אין קוד גישה, ולכן Pesto אינה יכולה לאמת את זהותך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にはパスコードがないため、Pestoは本人確認ができません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem código, então o Pesto não pode verificar quem é você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未设置密码，因此 Pesto 无法验证你的身份。"
          }
        }
      }
    },
    "This is not a readable JWT.": {
      "extractionState": "manual",
      "localizations": {
