    "Pesto notices clips you paste often and offers a shortcut, suggests snippets for repeated text, and tidies unused shortcuts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto notices clips you paste often and offers a shortcut, suggests snippets for repeated text, and tidies unused shortcuts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto merkt sich, welche Clips du oft einsetzt, bietet Kurzbefehle dafür an, schlägt Snippets für wiederkehrende Texte vor und räumt ungenutzte Kurzbefehle auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto detecta los clips que pegas a menudo y te propone atajos, sugiere fragmentos para textos repetidos y limpia los atajos que ya no usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto repère les clips que vous collez souvent pour vous proposer un raccourci, suggère des extraits pour les textes répétés et nettoie les raccourcis inutilisés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto מזהה קטעים שמדביקים לעיתים קרובות ומציעה קיצור, מציעה קטעים מוכנים לטקסט חוזר ומסדרת קיצורים לא פעילים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoは、よくペーストするクリップへのショートカット提案、繰り返し使うテキストのスニペット化、使われていないショートカットの整理を行います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto identifica clipes que você cola com frequência, oferece um atalho, sugere snippets para textos repetidos e remove atalhos sem uso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto 会留意你常粘贴的剪贴并推荐快捷键，为重复文本建议片段，并清理未使用的快捷键。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto замечает записи, которые вы часто вставляете, предлагает для них сочетания клавиш, советует сниппеты для повторяющегося текста и убирает неиспользуемые сочетания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto помічає кліпи, які ви часто вставляєте, пропонує для них скорочення, підказує сніпети для повторюваного тексту й прибирає невикористані скорочення."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 붙여넣는 클립에 단축키를 제안하고, 반복되는 텍스트는 스니펫으로 추천하며, 쓰지 않는 단축키를 정리해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto nota i clip che incolli spesso e propone un'abbreviazione, suggerisce snippet per i testi ripetuti e ripulisce le abbreviazioni inutilizzate."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto si všímá klipů, které vkládáte často, nabídne jim zkratku, navrhne úryvky pro opakovaný text a uklidí nepoužívané zkratky."
          }
        }
      }
    },
