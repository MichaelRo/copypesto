    "History clips are not pinned, so your retention setting may remove the older ones.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History clips are not pinned, so your retention setting may remove the older ones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlaufsclips sind nicht angeheftet, sodass deine Aufbewahrungseinstellung ältere Clips entfernen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips del historial no están fijados, así que tu ajuste de conservación puede eliminar los más antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips de l’historique ne sont pas épinglés ; votre réglage de conservation peut supprimer les plus anciens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים בהיסטוריה אינם מוצמדים, ולכן הגדרת השמירה עשויה להסיר את הישנים שבהם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴のクリップはピン留めされていないため、保持期間の設定により古いものから削除されることがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes do histórico não são fixados, então sua configuração de retenção pode remover os mais antigos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史剪贴未置顶，因此保留期限设置可能会移除较早的内容。"
          }
        }
      }
    },
