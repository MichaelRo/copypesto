    "Resets what Pesto has suggested and re-arms all suggestions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets what Pesto has suggested and re-arms all suggestions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt zurück, was Pesto vorgeschlagen hat, und aktiviert alle Vorschläge wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece lo que Pesto ha sugerido y vuelve a activar todas las sugerencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialise ce que Pesto a suggéré et réactive toutes les suggestions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפס את מה ש-Pesto הציעה ומפעיל מחדש את כל ההצעות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoの提案履歴をリセットし、すべての提案を再び有効にします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefine o que o Pesto sugeriu e reativa todas as sugestões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置 Pesto 已展示过的建议，并重新启用全部建议。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбрасывает историю подсказок Pesto и включает их заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидає історію пропозицій Pesto і знову вмикає їх показ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 Pesto가 보여준 제안을 초기화하고 모든 제안을 다시 활성화해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azzera i suggerimenti già mostrati da Pesto e li riattiva tutti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetuje dosavadní návrhy Pesta a znovu je povolí."
          }
        }
      }
    },
    "Suggestions are off. Turn them back on in Settings, under General.": {
      "localizations": {
        "en": {
