    "When locked, your history is blurred until you authenticate with %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When locked, your history is blurred until you authenticate with %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Sperre wird dein Verlauf unkenntlich gemacht, bis du dich mit %@ authentifizierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está bloqueado, tu historial aparece desenfocado hasta que te identificas con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’il est verrouillé, votre historique est flouté jusqu’à votre authentification avec %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשההיסטוריה נעולה, היא מטושטשת עד שתאמתו זהות באמצעות %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック中は、%@で認証するまで履歴にぼかしがかかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando bloqueado, seu histórico fica desfocado até você autenticar com %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定时，历史记录会保持模糊，直到你通过%@验证。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При блокировке история размывается до подтверждения через %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли історію заблоковано, вона розмивається до перевірки через %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠겨 있을 때는 %@로 인증하기 전까지 기록이 흐리게 표시돼요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è bloccata, la cronologia è sfocata finché non ti autentichi con %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zamčení se historie rozmaže, dokud se neověříte pomocí %@."
          }
        }
      }
    },
