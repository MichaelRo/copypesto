    "⌘S on a picture saves it here without asking; a name already there gets a number.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S on a picture saves it here without asking; a name already there gets a number."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S bei einem Bild sichert es hier ohne Nachfrage; ein vorhandener Name erhält eine Nummer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S en una imagen la guarda aquí sin preguntar; si el nombre ya existe, añade un número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S sur une image l’enregistre ici sans demander ; un nom déjà présent reçoit un numéro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S על תמונה שומר אותה כאן בלי לשאול; אם השם כבר קיים, מתווסף מספר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像で⌘Sを押すと確認なしでここに保存されます。同名のファイルには番号が付きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S em uma imagem a salva aqui sem perguntar; se o nome já existir, ganha um número."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图片上按 ⌘S 会直接保存至此，不再询问；若已有同名文件则自动编号。"
          }
        }
      }
    }
  },
  "version": "1.0"
}