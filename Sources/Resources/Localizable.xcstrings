    "Keep copies from other devices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep copies from other devices"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien von anderen Geräten behalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar copias de otros dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les copies des autres appareils"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירת העתקות ממכשירים אחרים"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスからのコピーを保持"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter cópias de outros dispositivos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留来自其他设备的拷贝"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять с других устройств"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігати копії з інших пристроїв"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기의 복사 항목 유지"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni copie da altri dispositivi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovávat kopie z ostatních zařízení"
          }
        }
      }
    },
    "Kept on this Mac, from the suggestions the shelf has shown. Nothing is sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this Mac, from the suggestions the shelf has shown. Nothing is sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal auf diesem Mac gespeichert – basierend auf den Vorschlägen der Ablage. Nichts wird versendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en este Mac, a partir de las sugerencias mostradas en el estante. No se envía nada a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé sur ce Mac, à partir des suggestions affichées sur l’étagère. Rien n’est envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר ב-Mac זה, מההצעות שהופיעו במדף. שום דבר לא נשלח החוצה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルフに表示された提案をもとにこのMac上に保存されます。外部へは一切送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado neste Mac a partir das sugestões mostradas na prateleira. Nada é enviado para lugar nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在此 Mac 本地，仅统计剪贴架展示过的建议，不会向外发送任何数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится на этом Mac по подсказкам с полки. Ничего никуда не отправляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається на цьому Mac із пропозицій, які показувала полиця. Нічого нікуди не надсилається."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸프에 표시된 제안을 바탕으로 이 Mac에만 보관돼요. 어디로도 전송되지 않아요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati su questo Mac dai suggerimenti mostrati sullo scaffale. Nulla viene inviato."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo na tomto Macu z návrhů zobrazených na poličce. Nic se nikam neodesílá."
          }
        }
      }
    },
