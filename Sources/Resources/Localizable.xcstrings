    "Clips you copy on an iPhone or iPad arrive through Universal Clipboard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips you copy on an iPhone or iPad arrive through Universal Clipboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips, die du auf einem iPhone oder iPad kopierst, kommen über die Allgemeine Zwischenablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips que copias en un iPhone o iPad llegan mediante el Portapapeles universal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips copiés sur iPhone ou iPad arrivent via le presse-papiers universel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים שתעתיקו ב-iPhone או ב-iPad מגיעים דרך לוח ההדבקות האוניברסלי."
          }
        },
        "ja": {
          "stringUnit": {
