    "Filled in when you paste. Add Question… in the editor asks one instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filled in when you paste. Add Question… in the editor asks one instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Einsetzen ausgefüllt. Mit „Frage hinzufügen…“ im Editor fragt Pesto stattdessen nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rellena al pegar. Si prefieres responder tú, usa Añadir pregunta… en el editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rempli au collage. Utilisez Ajouter une question… dans l’éditeur pour le demander à la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממולא בעת ההדבקה. ״הוספת שאלה…״ בעורך שואלת שאלה במקום זאת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペースト時に自動入力されます。エディタで「質問を追加…」を選ぶと、ペースト時に入力を求めるようになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenchido ao colar. Use Adicionar Pergunta… no editor para perguntar na hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴时自动填入。在编辑器中点按“添加问题…”可改为弹窗询问。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполняется при вставке. Кнопка «Добавить вопрос…» в редакторе запрашивает значение вручную."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підставляється під час вставлення. Кнопка «Додати запитання…» у редакторі натомість запитає вас."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣을 때 자동으로 채워져요. 편집기에서 ‘질문 추가…’를 누르면 대신 직접 물어봐요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilato quando incolli. Usa Aggiungi domanda… nell'editor per chiedere un valore."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplní se při vložení. Volba Přidat otázku… v editoru se na údaj místo toho zeptá."
          }
        }
      }
    },
