    "Copies an app marks as private are never kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies an app marks as private are never kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien, die eine App als privat markiert, werden nie gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias que una app marca como privadas nunca se guardan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies marquées comme privées par une app ne sont jamais conservées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העתקות שיישום מסמן כפרטיות לא נשמרות לעולם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが非公開とマークしたコピーは保存されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias marcadas como privadas por um app nunca são salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 标记为私密的拷贝内容绝不会保存。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные, помеченные приложением как приватные, не сохраняются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії, які програма позначає як приватні, ніколи не зберігаються."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 비공개로 표시한 복사 항목은 절대 저장하지 않아요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie contrassegnate come private da un'app non vengono mai salvate."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie, které aplikace označí jako soukromé, se nikdy neukládají."
          }
        }
      }
    },
