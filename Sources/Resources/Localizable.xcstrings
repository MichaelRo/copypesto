    "In Pesto, open Settings and turn on Insert from Pesto in other apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Pesto, open Settings and turn on Insert from Pesto in other apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Pesto die Einstellungen und aktiviere „Aus Pesto in anderen Apps einfügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Pesto, abre Ajustes y activa Insertar desde Pesto en otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Pesto, ouvrez Réglages et activez « Insérer depuis Pesto dans d’autres apps »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-Pesto, פתחו הגדרות והפעילו את ״הוספה מ-Pesto ביישומים אחרים״."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoで「設定」を開き、「他のアプリでPestoから挿入」をオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Pesto, abra Ajustes e ative Inserir do Pesto em outros apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Pesto 中打开“设置”，开启“在其他 App 中从 Pesto 插入”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Pesto откройте «Настройки» и включите «Вставлять из Pesto в других приложениях»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Pesto відкрийте Параметри й увімкніть вставлення з Pesto в інших програмах."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto에서 설정을 열고 ‘다른 앱에서 Pesto 항목 삽입’을 켜세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Pesto, apri Impostazioni e attiva Inserisci da Pesto in altre app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Pestu otevřete Nastavení a zapněte Vkládat z Pesta v jiných aplikacích."
          }
        }
      }
    },
    "Insert your clips in any app. Clips only, never passwords. You switch Pesto on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert your clips in any app. Clips only, never passwords. You switch Pesto on in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deine Clips in jeder App ein. Nur Clips, niemals Passwörter. Aktiviere Pesto dazu in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta tus clips en cualquier app. Solo clips, nunca contraseñas. Activa Pesto en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérez vos clips dans n’importe quelle app. Des clips uniquement, jamais de mots de passe. Activez Pesto dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את הקטעים שלכם בכל יישום. קטעים בלבד, אף פעם לא סיסמאות. מפעילים את Pesto בהגדרות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリにもクリップを挿入できます。対象はクリップのみで、パスワードは含まれません。「設定」でPestoをオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira seus clipes em qualquer app. Só clipes, nunca senhas. Ative o Pesto em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中插入你的剪贴。仅限剪贴内容，绝不涉及密码。请在“设置”中开启 Pesto。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляйте записи в любое приложение — только обычные записи, никогда пароли. Включается в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляйте кліпи в будь-якій програмі. Лише кліпи, ніколи паролі. Pesto вмикається в Параметрах."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서나 클립을 바로 삽입해요. 일반 클립만 지원하며 암호는 포함하지 않아요. 설정에서 Pesto를 켤 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci i tuoi clip in qualsiasi app. Solo clip, mai password. Attivi Pesto in Impostazioni."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vkládejte své klipy v jakékoli aplikaci. Jen klipy, nikdy hesla. Pesto zapnete v Nastavení."
          }
        }
      }
    },
    "Install updates automatically": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install updates automatically"
          }
        },
