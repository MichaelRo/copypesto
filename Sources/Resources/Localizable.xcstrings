    "Double-click a snippet to edit it. A shortcut such as ⌃1 pastes one in any app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click a snippet to edit it. A shortcut such as ⌃1 pastes one in any app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke ein Snippet zum Bearbeiten. Mit einem Kurzbefehl wie ⌃1 setzt du es in jeder App ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en un fragmento para editarlo. Un atajo como ⌃1 lo pega en cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur un extrait pour le modifier. Un raccourci comme ⌃1 le colle dans n’importe quelle app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה כפולה על קטע מוכן פותחת אותו לעריכה. קיצור כמו ⌃1 מדביק אותו בכל יישום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スニペットをダブルクリックして編集できます。⌃1 などのショートカットでどのアプリにもペーストできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes em um snippet para editar. Um atalho como ⌃1 cola em qualquer app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击片段即可编辑。按 ⌃1 等快捷键可在任意 App 中直接粘贴。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды нажмите на сниппет для редактирования. Сочетание вроде ⌃1 вставит его в любом приложении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі клацніть сніпет, щоб змінити його. Скорочення на кшталт ⌃1 вставляє його в будь-якій програмі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스니펫을 이중 클릭해 편집하세요. ⌃1 같은 단축키로 어느 앱에서나 붙여넣을 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic su uno snippet per modificarlo. Un'abbreviazione come ⌃1 lo incolla in qualsiasi app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojklikem úryvek upravíte. Zkratka jako ⌃1 ho vloží v jakékoli aplikaci."
          }
        }
      }
    },
    "Drag to reorder. They appear on the shelf in this order.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. They appear on the shelf in this order."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuordnen ziehen. Sie erscheinen in dieser Reihenfolge auf der Ablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Aparecen en el estante en este orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Ils apparaissent sur l’étagère dans cet ordre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררו כדי לשנות את הסדר. הם יופיעו במדף בסדר הזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。シェルフにはこの順に表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Aparecem na prateleira nesta ordem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整顺序，剪贴架将按此顺序显示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите для сортировки. В этом порядке они будут на полке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягуйте, щоб змінити порядок. Саме так вони йтимуть на полиці."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그해서 순서를 바꾸세요. 셸프에도 이 순서대로 나타나요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Appaiono sullo scaffale in quest'ordine."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změníte pořadí. Na poličce se zobrazí takto."
          }
        }
      }
    },
