    "NSAccessibilityUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto uses Accessibility to paste clips directly into the app you were using, and to notice a double ⌘C."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto necesita permiso de Accesibilidad para pegar clips directamente en la app que estabas usando y detectar si pulsas ⌘C dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto utilise l’Accessibilité pour coller des clips directement dans l’app que vous utilisez et pour détecter un double ⌘C."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto nutzt die Bedienungshilfen, um Clips direkt in die aktive App einzusetzen und ein doppeltes ⌘C zu erkennen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoは、使用中のアプリに直接クリップをペーストしたり、⌘Cの2回押しを検出したりするためにアクセシビリティを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto 需要辅助功能权限，才能将剪贴直接粘贴到当前使用的 App 中，并检测双击 ⌘C。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto usa a Acessibilidade para colar clipes diretamente no app em uso e detectar um toque duplo em ⌘C."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto משתמשת בנגישות כדי להדביק קטעים ישירות ליישום שבו עבדת, וכדי לזהות לחיצה כפולה על ⌘C."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto использует Универсальный доступ, чтобы вставлять записи прямо в активное приложение и распознавать двойное нажатие ⌘C."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto використовує Доступність, щоб вставляти кліпи безпосередньо в активну програму й розпізнавати подвійне ⌘C."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto는 사용 중이던 앱에 클립을 바로 붙여넣고 ⌘C 두 번 누르기를 감지하기 위해 손쉬운 사용 권한을 사용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto usa Accessibilità per incollare i clip direttamente nell'app che stavi usando e per rilevare un doppio ⌘C."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto používá Zpřístupnění k přímému vkládání klipů do aplikace, kterou právě používáte, a k rozpoznání dvojitého stisknutí ⌘C."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto asks for Face ID before it shows your clips when the History Lock is on, and before it shows a hidden clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto solicita Face ID antes de mostrar tus clips cuando el bloqueo del historial está activo y al revelar un clip oculto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto demande Face ID avant d’afficher vos clips lorsque le verrouillage de l’historique est activé, ainsi qu’avant d’afficher un clip masqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto fragt nach Face ID, bevor bei aktiver Verlaufssperre Clips oder ein ausgeblendeter Clip angezeigt werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴ロックがオンのときや非表示のクリップを表示するときに、Face IDでの認証を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启历史记录锁定时，或在显示隐藏的剪贴前，Pesto 会请求面容 ID 验证。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pesto pede o Face ID antes de mostrar seus clipes com o Bloqueio de Histórico ativado e antes de revelar um clipe oculto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Pesto מבקשת אימות Face ID לפני הצגת הקטעים שלך כשנעילת ההיסטוריה פעילה, ולפני הצגת קטע מוסתר."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto запрашивает Face ID перед показом истории при включённой блокировке и перед открытием скрытых записей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto запитує Face ID перед показом кліпів, коли ввімкнено блокування історії, і перед показом прихованого кліпу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto는 기록 잠금이 켜져 있을 때 클립을 표시하거나 가려진 클립을 보기 전에 Face ID 인증을 요청합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto richiede Face ID prima di mostrare i tuoi clip quando il blocco cronologia è attivo e prima di mostrare un clip nascosto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto vyžaduje Face ID před zobrazením klipů při zapnutém zámku historie a před odkrytím skrytého klipu."
          }
        }
      }
    },
