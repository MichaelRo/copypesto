          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se clipes podem aparecer na Tela Bloqueada e qual origem mostrar. Segredos nunca aparecem."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו אם קטעים יכולים להופיע במסך הנעילה ומאיזה מקור. סודות אינם מופיעים לעולם."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, могут ли записи отображаться на экране блокировки и какой источник показывать. Секреты не показываются никогда."
          }
