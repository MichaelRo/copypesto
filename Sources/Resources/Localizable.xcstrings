    "Bottom rests on the Dock. Top hangs from the menu bar, below the notch if your Mac has one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom rests on the Dock. Top hangs from the menu bar, below the notch if your Mac has one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten ruht sie auf dem Dock. Oben hängt sie an der Menüleiste – bei Macs mit Notch direkt darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abajo se apoya en el Dock. Arriba sale de la barra de menús, bajo la muesca si tu Mac tiene una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bas, repose sur le Dock. En haut, s’accroche à la barre des menus, sous l’encoche si votre Mac en a une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למטה נצמד ל-Dock. למעלה נפתח משורת התפריטים, מתחת למגרעת אם יש כזו ב-Mac שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下はDockの上に、上はメニューバーの下（ノッチがあるMacはその下）に表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Embaixo, apoia-se no Dock. No topo, fica abaixo da barra de menus (e do entalhe, se o seu Mac tiver)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部贴靠程序坞；顶部紧贴菜单栏下方（若 Mac 有刘海则位于其下方）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снизу — над Dock. Сверху — под строкой меню (ниже выреза, если он есть на вашем Mac)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знизу спирається на Dock. Згори прилягає до рядка меню — під вирізом, якщо він є на вашому Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단은 Dock 위에 놓이고, 상단은 메뉴 막대 아래(노치가 있는 Mac에서는 노치 아래)에 걸려요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In basso si appoggia al Dock. In alto scende dalla barra dei menu, sotto il notch se il tuo Mac ne ha uno."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dole leží na Docku. Nahoře visí z řádku nabídek, pod výřezem, pokud ho váš Mac má."
          }
        }
      }
    },
