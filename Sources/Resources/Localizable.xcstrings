    "Clips past the new limit are deleted now. Pinned clips stay. It can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips past the new limit are deleted now. Pinned clips stay. It can’t be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips über dem neuen Limit werden jetzt gelöscht. Angeheftete Clips bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips que superen el nuevo límite se borrarán ahora. Los fijados se conservan. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips au-delà de la nouvelle limite sont supprimés immédiatement. Les clips épinglés sont conservés. C’est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים מעבר למגבלה החדשה נמחקים מיד. קטעים מוצמדים נשמרים. לא ניתן לבטל פעולה זו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい上限を超えるクリップは今すぐ削除されます。ピン留めしたクリップは残ります。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes além do novo limite serão apagados agora. Os fixados permanecem. Essa ação não pode ser desfeita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出新上限的剪贴将被立即删除，已固定的剪贴会保留。此操作不可撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи сверх нового лимита удалятся сразу. Закреплённые останутся. Это действие необратимо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кліпи поза новим лімітом буде видалено зараз. Закріплені залишаться. Цю дію не можна скасувати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 제한을 넘는 클립은 지금 삭제돼요. 고정된 클립은 남으며, 실행 취소할 수 없어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I clip oltre il nuovo limite vengono eliminati ora. I clip fissati restano. L'operazione non è annullabile."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy nad nový limit se smažou hned. Připnuté klipy zůstanou. Tuto akci nelze vrátit."
          }
        }
      }
    },
