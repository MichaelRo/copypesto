    "Clips with secrets stay on this %@ unless you choose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips with secrets stay on this %@ unless you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips mit Geheimnissen bleiben auf diesem %@, sofern du nichts anderes wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips con secretos se quedan en este %@ salvo que decidas lo contrario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips contenant des secrets restent sur cet appareil (%@), sauf choix contraire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים עם סודות נשארים ב-%@ זה אלא אם תבחרו אחרת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットを含むクリップは、選択しない限りこの%@にとどまります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes com segredos ficam neste %@, salvo se você escolher outra opção."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含机密的剪贴默认留在此 %@ 上，除非你另行选择。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи с секретами остаются на этом %@, если не выбрать иное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кліпи із секретами залишаються на цьому пристрої (%@), якщо ви не вкажете інше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택하지 않는 한 비밀 정보가 포함된 클립은 이 %@에만 남아요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I clip con segreti restano su questo %@, salvo tua scelta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy s tajnými údaji zůstávají na tomto zařízení (%@), pokud neurčíte jinak."
          }
        }
      }
    },
