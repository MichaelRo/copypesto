    "Text only. Secrets are masked as they would be on a copy, and clips you already have are skipped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text only. Secrets are masked as they would be on a copy, and clips you already have are skipped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Text. Geheimnisse werden wie beim Kopieren maskiert und bereits vorhandene Clips übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo texto. Los secretos se ocultan como al copiar y los clips que ya tienes se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte uniquement. Les secrets sont masqués comme lors d’une copie et les clips déjà présents sont ignorés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט בלבד. סודות מוסתרים כפי שהם בהעתקה, וקטעים שכבר קיימים אצלך מדולגים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストのみ。シークレットはコピー時と同様にマスクされ、すでにあるクリップはスキップされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas texto. Segredos ficam ocultos como ao copiar, e clipes que você já tem são ignorados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限文本。机密内容会像拷贝时一样保持遮盖，已有的剪贴会被跳过。"
          }
        }
      }
    },
    "Text you have pasted from the shelf more than twice. Make a snippet to keep it handy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text you have pasted from the shelf more than twice. Make a snippet to keep it handy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, den du mehr als zweimal von der Ablage eingesetzt hast. Erstelle ein Snippet, um ihn griffbereit zu haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto que has pegado desde el estante más de dos veces. Crea un fragmento para tenerlo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte collé depuis l’étagère plus de deux fois. Créez un extrait pour l’avoir sous la main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט שהדבקת מהמדף יותר מפעמיים. צרו ממנו קטע מוכן כדי שיהיה זמין מיד."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルフから3回以上ペーストしたテキストです。スニペットにするとすぐ使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto colado da estante mais de duas vezes. Crie um snippet para mantê-lo à mão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已从剪贴架粘贴超过两次的文本。可将其创建为片段方便取用。"
          }
        }
      }
    },
    "Text you paste again and again, with the date, a name or a choice filled in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
