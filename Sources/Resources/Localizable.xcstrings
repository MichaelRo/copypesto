    "Clips with secrets stay on this %@ unless you choose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips with secrets stay on this %@ unless you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips mit Geheimnissen bleiben auf diesem %@, sofern du nichts anderes wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips con secretos permanecen en este %@ salvo que indiques lo contrario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips contenant des secrets restent sur cet appareil (%@), sauf choix contraire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים עם סודות נשארים ב-%@ זה אלא אם תבחרו אחרת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットを含むクリップは、選択しない限りこの%@にとどまります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes com segredos ficam neste %@, a menos que você escolha diferente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含机密的剪贴默认留在此 %@ 上，除非你另行选择。"
          }
        }
      }
    },
