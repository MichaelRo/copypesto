    "Up to %@ would be added. %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %1$@ would be added. %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %1$@ würden hinzugefügt. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadirían hasta %1$@. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %1$@ seraient ajoutés. %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יתווספו עד %1$@. %2$@"
          }
        },
