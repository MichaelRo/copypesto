    "Applied silently to every copied text clip before it is stored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied silently to every copied text clip before it is stored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird automatisch auf jeden kopierten Textclip angewendet, bevor er gespeichert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica automáticamente a cada texto copiado antes de guardarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué discrètement à chaque texte copié avant son enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחל בשקט על כל קטע טקסט שמועתק לפני השמירה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたテキストクリップの保存前に自動で適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado silenciosamente a cada clipe de texto copiado antes de ser salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在保存前自动静默处理每条拷贝的文本剪贴。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Незаметно применяется к каждому скопированному тексту перед сохранением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується непомітно до кожного скопійованого тексту перед збереженням."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 모든 텍스트 클립을 저장하기 전에 조용히 적용해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicato automaticamente a ogni clip di testo copiato prima di salvarlo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije se tiše na každý zkopírovaný textový klip před jeho uložením."
