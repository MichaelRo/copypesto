    "Reduce Transparency is on in System Settings, so the shelf is solid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Transparency is on in System Settings, so the shelf is solid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Transparenz reduzieren“ ist in den Systemeinstellungen aktiviert, daher ist die Ablage deckend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir transparencia está activado en Ajustes del Sistema, así que el estante es sólido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire la transparence est activé dans Réglages Système ; l’étagère reste unie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״הפחתת שקיפות״ פעילה בהגדרות המערכת, ולכן המדף אטום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
