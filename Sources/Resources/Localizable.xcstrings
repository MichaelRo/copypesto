    "Pesto %@ is ready. It installs when Pesto quits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto %@ is ready. It installs when Pesto quits."
          }
        },
