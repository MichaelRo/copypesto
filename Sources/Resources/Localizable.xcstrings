    "Turn it on in System Settings, or join with a recovery key instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in System Settings, or join with a recovery key instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere es in den Systemeinstellungen oder tritt stattdessen mit einem Wiederherstellungsschlüssel bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes del Sistema o únete con una clave de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans Réglages Système ou rejoignez avec une clé de récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו זאת בהגדרות המערכת, או הצטרפו באמצעות מפתח שחזור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でオンにするか、代わりに復旧キーで参加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative nos Ajustes do Sistema ou entre com uma chave de recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”中开启，或改用恢复密钥加入。"
          }
        }
      }
    },
    "Turn it on in the Settings app, or join with a recovery key instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in the Settings app, or join with a recovery key instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere es in der App „Einstellungen“ oder tritt stattdessen mit einem Wiederherstellungsschlüssel bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en la app Ajustes o únete con una clave de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans l’app Réglages ou rejoignez avec une clé de récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו זאת ביישום ״הגדרות״, או הצטרפו באמצעות מפתח שחזור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」アプリでオンにするか、代わりに復旧キーで参加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative no app Ajustes ou entre com uma chave de recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”App 中开启，或改用恢复密钥加入。"
          }
        }
      }
    },
    "Turning sync off keeps this device in your sync, so turning it on again needs nothing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning sync off keeps this device in your sync, so turning it on again needs nothing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Deaktivieren von Sync bleibt dieses Gerät verknüpft; zum erneuten Aktivieren ist nichts nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la sincronización mantiene este dispositivo vinculado, así que volver a activarla no requiere nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver la synchronisation garde cet appareil dans votre sync ; la réactiver ne demande rien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיבוי הסנכרון שומר מכשיר זה בסנכרון שלך, כך שהפעלה מחדש אינה דורשת דבר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期をオフにしてもこの端末は同期グループに残るため、再びオンにする際に手順は不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar a sincronização mantém este dispositivo conectado, então reativá-la não exige nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步后此设备仍会保留在同步中，再次开启时无需额外操作。"
