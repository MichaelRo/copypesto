    },
    "Pesto auto-selects this collection when the chosen app becomes frontmost.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto auto-selects this collection when the chosen app becomes frontmost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto wählt diese Sammlung automatisch aus, sobald die gewählte App aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
