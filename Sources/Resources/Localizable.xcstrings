    "Text only. Secrets are masked as they would be on a copy, and clips you already have are skipped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text only. Secrets are masked as they would be on a copy, and clips you already have are skipped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Text. Geheimnisse werden wie beim Kopieren maskiert und bereits vorhandene Clips übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo texto. Los secretos se ocultan como al copiar y los clips que ya tienes se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte uniquement. Les secrets sont masqués comme lors d’une copie et les clips déjà présents sont ignorés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט בלבד. סודות מוסתרים בדיוק כמו בהעתקה, ועל קטעים שכבר קיימים אצלך מדלגים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストのみ。シークレットはコピー時と同様にマスクされ、すでにあるクリップはスキップされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas texto. Segredos ficam ocultos como na cópia, e clipes que você já tem são ignorados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限文本。机密内容会像拷贝时一样保持遮盖，已有的剪贴会被跳过。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только текст. Секреты маскируются как при копировании, а уже существующие записи пропускаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише текст. Секрети приховуються як під час копіювання, а наявні у вас кліпи пропускаються."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트만 포함돼요. 비밀 정보는 복사할 때처럼 가려지며, 이미 있는 클립은 건너뛰어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo testo. I segreti restano mascherati come alla copia e i clip già presenti vengono saltati."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze text. Tajné údaje jsou zamaskované stejně jako při kopírování a klipy, které už máte, se přeskočí."
          }
        }
      }
    },
    "Text you have pasted from the shelf more than twice. Make a snippet to keep it handy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text you have pasted from the shelf more than twice. Make a snippet to keep it handy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, den du mehr als zweimal von der Ablage eingesetzt hast. Sichere ihn als Snippet, um ihn griffbereit zu haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto que has pegado desde el estante más de dos veces. Crea un fragmento para tenerlo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte collé depuis l’étagère plus de deux fois. Créez un extrait pour l’avoir sous la main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט שהדבקת מהמדף יותר מפעמיים. צרו ממנו קטע מוכן כדי שיהיה זמין מיד."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルフから3回以上ペーストしたテキストです。スニペットにするとすぐ使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto que você colou da prateleira mais de duas vezes. Crie um snippet para deixar à mão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已从剪贴架粘贴超过两次的文本。可将其创建为片段方便取用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, который вы вставляли с полки больше двух раз. Сделайте сниппет, чтобы держать его под рукой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, який ви вставляли з полиці понад два рази. Зробіть із нього сніпет, щоб був під рукою."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸프에서 2번 넘게 붙여넣은 텍스트예요. 스니펫으로 만들어 두면 편해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo incollato dallo scaffale più di due volte. Trasformalo in uno snippet per averlo sempre pronto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, který jste z poličky vložili více než dvakrát. Udělejte z něj úryvek, ať ho máte po ruce."
          }
        }
      }
    },
    "Text you paste again and again, with the date, a name or a choice filled in.": {
      "extractionState": "manual",
      "localizations": {
