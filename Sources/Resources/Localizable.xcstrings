          "stringUnit": {
            "state": "translated",
            "value": "No collections yet. Add one, or let Pesto suggest some from what you copy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Sammlungen. Erstelle eine oder lass dir von Pesto passende vorschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay colecciones. Crea una o deja que Pesto te sugiera algunas según lo que copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune collection pour le moment. Ajoutez-en une, ou laissez Pesto en suggérer d’après vos copies."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין אוספים. הוסיפו אוסף, או תנו ל-Pesto להציע לפי מה שאתם מעתיקים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションはまだありません。追加するか、コピー内容からPestoに提案させましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma coleção ainda. Crie uma ou deixe o Pesto sugerir a partir do que você copia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无合集。你可以新建一个，或让 Pesto 根据你拷贝的内容推荐。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коллекций пока нет. Создайте первую или позвольте Pesto предложить их из ваших записей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колекцій ще немає. Створіть власну або дозвольте Pesto запропонувати їх на основі скопійованого."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 컬렉션이 없어요. 새로 추가하거나, 복사한 내용을 바탕으로 Pesto의 제안을 받아 보세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna raccolta ancora. Aggiungine una o lascia che Pesto ne suggerisca da ciò che copi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné kolekce. Přidejte vlastní, nebo nechte Pesto nějaké navrhnout podle toho, co kopírujete."
          }
        }
      }
    },
