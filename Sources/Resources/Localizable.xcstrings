    "Choose whether clips can appear on the Lock Screen and which source to show. Secrets never appear.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether clips can appear on the Lock Screen and which source to show. Secrets never appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si pueden mostrarse clips en la pantalla bloqueada y qué fuente mostrar. Los secretos nunca aparecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si des clips peuvent s’afficher sur l’écran verrouillé et quelle source montrer. Les secrets n’apparaissent jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob Clips auf dem Sperrbildschirm erscheinen dürfen und welche Quelle gezeigt wird. Geheimnisse erscheinen nie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面にクリップを表示できるかどうかと表示元を選びます。シークレットは決して表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
