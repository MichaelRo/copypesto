    "After Recent, Pinned and Snippets, in this order. Drag to reorder, swipe to remove.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After Recent, Pinned and Snippets, in this order. Drag to reorder, swipe to remove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de Recientes, Fijados y Fragmentos, en este orden. Arrastra para reordenar, desliza para quitar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après Récents, Épinglés et Extraits, dans cet ordre. Faites glisser pour réorganiser, balayez pour retirer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Zuletzt, Angeheftet und Snippets, in dieser Reihenfolge. Zum Sortieren ziehen, zum Entfernen streichen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最近」「ピン留め」「スニペット」の後にこの順で並びます。ドラッグで並べ替え、スワイプで削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此顺序排在“最近”“置顶”和“片段”之后。拖动以重新排序，轻扫以移除。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de Recentes, Fixados e Trechos, nesta ordem. Arraste para reordenar, deslize para remover."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחרי אחרונים, מוצמדים וקטעי טקסט, בסדר זה. גרור לשינוי סדר, החלק להסרה."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После «Недавних», «Закреплённых» и «Сниппетов» в этом порядке. Перетащите для сортировки, смахните для удаления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після «Недавніх», «Закріплених» і «Сніпетів» у цьому порядку. Перетягніть для зміни порядку, змахніть для видалення."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘최근’, ‘고정됨’, ‘스니펫’ 뒤에 이 순서로 표시됩니다. 드래그하여 순서를 바꾸고 쓸어넘겨 제거하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo Recenti, Fissati e Frammenti, in quest’ordine. Trascina per riordinare, scorri per rimuovere."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za Nedávnými, Připnutými a Úryvky v tomto pořadí. Přetažením změňte pořadí, přejetím odeberte."
          }
        }
      }
    },
