    "Group clips on the shelf. A smart collection fills itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group clips on the shelf. A smart collection fills itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppiere Clips auf der Ablage. Eine intelligente Sammlung füllt sich von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa clips en el estante. Una colección inteligente se llena sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez vos clips sur l’étagère. Une collection intelligente se remplit toute seule."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצו קטעים במדף. אוסף חכם מתמלא מעצמו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルフ上のクリップを整理できます。スマートコレクションは条件に合うものを自動で集めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe clipes na prateleira. Uma coleção inteligente se preenche sozinha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在剪贴架上分组管理剪贴。智能合集会自动收集匹配内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группируйте записи на полке. Смарт-коллекция собирает их сама."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групуйте кліпи на полиці. Смартколекція наповнюється сама."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸프에서 클립을 그룹으로 묶어 보세요. 스마트 컬렉션은 알아서 채워져요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa i clip sullo scaffale. Una raccolta smart si riempie da sola."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seskupujte klipy na poličce. Chytrá kolekce se plní sama."
          }
        }
      }
    },
