    "Bottom rests on the Dock. Top hangs from the menu bar, below the notch if your Mac has one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom rests on the Dock. Top hangs from the menu bar, below the notch if your Mac has one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten liegt sie auf dem Dock. Oben hängt sie an der Menüleiste, unter der Notch, falls dein Mac eine hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abajo apoya sobre el Dock. Arriba cuelga de la barra de menús, bajo la muesca si tu Mac tiene una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bas, repose sur le Dock. En haut, s’accroche à la barre des menus, sous l’encoche si votre Mac en a une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למטה נצמד ל-Dock. למעלה נתלה משורת התפריטים, מתחת למגרעת אם יש כזו ב-Mac שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下はDockの上に、上はメニューバーの下（ノッチがあるMacはその下）に表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na parte inferior, apoia-se no Dock. No topo, fica abaixo da barra de menus, e abaixo do entalhe se o Mac tiver um."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部贴靠程序坞；顶部悬停在菜单栏下方（若 Mac 有刘海则在其下方）。"
          }
        }
      }
    },
