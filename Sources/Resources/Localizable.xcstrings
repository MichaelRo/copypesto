    "Starts quietly and stays out of the way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts quietly and stays out of the way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet leise und bleibt im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inicia discretamente y no estorba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre discrètement et reste en retrait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נפתחת בשקט ולא מפריעה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かに起動し、作業の邪魔をしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia silenciosamente e não atrapalha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静默启动，不打扰你。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускается незаметно и не мешает работе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускається тихо й не заважає роботі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 없이 조용히 시작해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si avvia in silenzio senza disturbare."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouští se tiše a nepřekáží."
          }
        }
