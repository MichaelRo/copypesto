    "Delete this collection? The clips in it stay in your history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this collection? The clips in it stay in your history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sammlung löschen? Die enthaltenen Clips bleiben in deinem Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta colección? Sus clips seguirán en tu historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette collection ? Les clips qu’elle contient restent dans votre historique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את האוסף הזה? הקטעים שבו יישארו בהיסטוריה שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコレクションを削除しますか？中のクリップは履歴に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta coleção? Os clipes continuam no seu histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此合集？其中的剪贴仍会保留在历史记录中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить коллекцию? Записи из неё останутся в истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цю колекцію? Кліпи з неї залишаться в історії."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컬렉션을 삭제할까요? 안에 있는 클립은 기록에 그대로 남아요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questa raccolta? I clip al suo interno restano nella cronologia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat tuto kolekci? Klipy v ní zůstanou ve vaší historii."
          }
        }
      }
    },
    "Deleting a clip on one device deletes it on all. Sync is not a backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a clip on one device deletes it on all. Sync is not a backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du einen Clip auf einem Gerät löscht, wird er überall gelöscht. Sync ist kein Backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliminas un clip en un dispositivo, se elimina en todos. La sincronización no es una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un clip sur un appareil le supprime partout. La synchronisation n’est pas une sauvegarde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת קטע במכשיר אחד מוחקת אותו בכולם. סנכרון הוא לא גיבוי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのデバイスでクリップを削除するとすべてのデバイスから削除されます。同期はバックアップではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar um clipe em um dispositivo o apaga em todos. Sincronização não é backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一台设备上删除剪贴，所有设备上都会同步删除。同步不能替代备份。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление записи на одном устройстве удаляет её везде. Синхронизация — не резервная копия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення кліпу на одному пристрої видаляє його всюди. Синхронізація не є резервною копією."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 기기에서 클립을 삭제하면 모든 기기에서 삭제돼요. 동기화는 백업이 아니에요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminando un clip su un dispositivo lo elimini ovunque. La sincronizzazione non è un backup."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazání klipu na jednom zařízení ho smaže na všech. Synchronizace není záloha."
          }
        }
      }
    },
    "Describe Image needs a model that can read pictures, which this Mac’s does not have yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe Image needs a model that can read pictures, which this Mac’s does not have yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bild beschreiben“ benötigt ein Modell mit Bilderkennung – auf diesem Mac ist das noch nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describir imagen necesita un modelo capaz de leer imágenes, algo que el de este Mac aún no admite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Décrire l’image » nécessite un modèle capable de lire les images, pas encore disponible sur ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״תיאור תמונה״ דורש מודל שמסוגל לקרוא תמונות, מה שעדיין אין ב-Mac זה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「画像を説明」には画像に対応したモデルが必要ですが、このMacのモデルはまだ対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrever Imagem precisa de um modelo capaz de ler imagens, algo que o deste Mac ainda não tem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“描述图片”需要能够识图的模型，此 Mac 目前尚不支持。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для описания изображений нужна модель, умеющая читать картинки — на этом Mac её пока нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Опис зображення» потребує моделі, що вміє читати зображення — на цьому Mac її ще немає."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘이미지 설명’ 기능을 쓰려면 이미지를 읽을 수 있는 모델이 필요한데, 이 Mac에는 아직 없어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi immagine richiede un modello capace di leggere le immagini, non ancora disponibile su questo Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce Popsat obrázek vyžaduje model, který umí číst obrázky – tento Mac ho zatím nemá."
          }
        }
      }
    },
