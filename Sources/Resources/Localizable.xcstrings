    "Allow Pesto in System Settings → Login Items to finish enabling this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Pesto in System Settings → Login Items to finish enabling this."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Pesto in den Systemeinstellungen → Anmeldeobjekte, um dies abzuschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Pesto en Ajustes del Sistema → Ítems de inicio para terminar de activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Pesto dans Réglages Système → Ouverture pour finaliser l’activation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאפשר את Pesto בהגדרות המערכת ← פריטי התחברות כדי לסיים את ההפעלה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効化を完了するには「システム設定」→「ログイン項目」でPestoを許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Pesto em Ajustes do Sistema → Itens de Início para concluir a ativação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”→“登录项”中允许 Pesto 以完成启用。"
          }
        }
      }
    },
    "Allow it only if this Mac shows the same words. It will be able to read your synced clips.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow it only if this Mac shows the same words. It will be able to read your synced clips."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube dies nur, wenn dieser Mac dieselben Wörter zeigt. Er kann dann deine synchronisierten Clips lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permítelo solo si este Mac muestra las mismas palabras. Podrá leer tus clips sincronizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez uniquement si ce Mac affiche les mêmes mots. Il pourra lire vos clips synchronisés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשרו רק אם ב-Mac זה מופיעות אותן מילים. המכשיר יוכל לקרוא את הקטעים המסונכרנים שלכם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにも同じ単語が表示されている場合のみ許可してください。同期されたクリップを読み取れるようになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita somente se este Mac mostrar as mesmas palavras. Ele poderá ler seus clipes sincronizados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当此 Mac 显示相同词语时才允许。该设备将能够读取你同步的剪贴。"
          }
        }
      }
    },
