    "Nothing is asked yet. Add a question, and Pesto asks for it when you paste.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is asked yet. Add a question, and Pesto asks for it when you paste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Fragen. Füge eine hinzu, und Pesto fragt beim Einsetzen danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay preguntas. Añade una y Pesto te la hará al pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune question pour le moment. Ajoutez-en une et Pesto vous la posera au collage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין שאלות. הוסיפו שאלה, ו-Pesto תשאל אותה בזמן ההדבקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問はまだありません。追加すると、ペースト時にPestoが入力を求めます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pergunta ainda. Adicione uma e o Pesto pergunta ao colar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置问题。添加问题后，Pesto 会在粘贴时弹窗询问。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросов пока нет. Добавьте вопрос, и Pesto спросит ответ при вставке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитань ще немає. Додайте запитання, і Pesto запитає вас під час вставлення."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 질문이 없어요. 질문을 추가하면 붙여넣을 때 Pesto가 값을 물어봐요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna domanda ancora. Aggiungi una domanda e Pesto te la chiederà quando incolli."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím bez otázek. Přidejte otázku a Pesto se na ni při vložení zeptá."
          }
        }
      }
    },
    "Nothing is changed until you have seen what the backup holds and confirmed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is changed until you have seen what the backup holds and confirmed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts geändert, bevor du den Inhalt des Backups geprüft und bestätigt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada hasta que veas qué contiene la copia de seguridad y lo confirmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est modifié tant que vous n’avez pas vérifié le contenu de la sauvegarde et confirmé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא ישתנה עד שתראו מה יש בגיבוי ותאשרו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの内容を確認して承認するまで、何も変更されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda até você conferir o conteúdo do backup e confirmar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你查看备份内容并确认之前，不会更改任何内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменится, пока вы не посмотрите содержимое копии и не подтвердите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не зміниться, доки ви не переглянете вміст резервної копії та не підтвердите."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 내용을 직접 확인하고 승인하기 전까지는 아무것도 바뀌지 않아요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene modificato finché non vedi cosa contiene il backup e confermi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nezmění, dokud si neprohlédnete obsah zálohy a nepotvrdíte ho."
          }
        }
      }
    },
    "Nothing is deleted. Clips are merged both ways, and Pesto stays usable while it runs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. Clips are merged both ways, and Pesto stays usable while it runs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gelöscht. Clips werden in beide Richtungen zusammengeführt, und Pesto bleibt währenddessen nutzbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada. Los clips se combinan en ambos sentidos y puedes seguir usando Pesto mientras tanto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé. Les clips sont fusionnés dans les deux sens et Pesto reste utilisable pendant l’opération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא נמחק. הקטעים מתמזגים לשני הכיוונים, ו-Pesto נשארת זמינה לשימוש בזמן הפעולה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップが削除されることはありません。双方向に統合され、実行中もPestoをそのまま使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é apagado. Os clipes são mesclados nos dois sentidos e o Pesto continua funcionando durante o processo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会删除任何内容。剪贴会双向合并，运行期间 Pesto 仍可正常使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удаляется. Записи объединяются в обе стороны, а Pesto продолжает работать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видаляється. Кліпи об’єднуються в обидва боки, а Pesto далі працює під час процесу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 삭제되지 않아요. 클립은 양방향으로 병합되며, 진행 중에도 Pesto를 계속 쓸 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene eliminato. I clip vengono uniti in entrambe le direzioni e Pesto resta utilizzabile."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nesmaže. Klipy se sloučí oběma směry a Pesto můžete během toho dál používat."
          }
        }
      }
    },
    "Nothing is deleted. Clips are merged both ways, and the shelf stays usable while it runs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. Clips are merged both ways, and the shelf stays usable while it runs."
          }
        },
        "de": {
          "stringUnit": {
