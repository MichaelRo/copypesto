    "Selected text and the app name are not available on iPhone and iPad, so they stay empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected text and the app name are not available on iPhone and iPad, so they stay empty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählter Text und App-Name stehen auf iPhone und iPad nicht zur Verfügung und bleiben daher leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto seleccionado y el nombre de la app no están disponibles en iPhone y iPad, así que quedan vacíos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte sélectionné et le nom de l’app ne sont pas disponibles sur iPhone et iPad ; ils restent donc vides."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט הנבחר ושם היישום לא זמינים ב-iPhone וב-iPad, ולכן הם נשארים ריקים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択テキストとアプリ名はiPhoneおよびiPadでは取得できないため空になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto selecionado e o nome do app não ficam disponíveis no iPhone e iPad, então permanecem vazios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 iPad 上无法获取所选文本和 App 名称，因此会留空。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделенный текст и имя приложения недоступны на iPhone и iPad, поэтому остаются пустыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний текст і назва програми недоступні на iPhone та iPad, тому залишаються порожніми."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트와 앱 이름은 iPhone과 iPad에서 지원되지 않아 비워 두어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo selezionato e il nome dell'app non sono disponibili su iPhone e iPad, quindi restano vuoti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraný text a název aplikace nejsou na iPhonu a iPadu dostupné, takže zůstávají prázdné."
          }
        }
      }
    },
