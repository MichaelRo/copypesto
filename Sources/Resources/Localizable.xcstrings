    "Another app already uses this, so it will not work. Record a different shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app already uses this, so it will not work. Record a different shortcut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App nutzt diesen Kurzbefehl bereits. Nimm einen anderen auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ya usa este atajo, así que no funcionará. Graba uno distinto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise déjà ce raccourci ; il ne fonctionnera pas. Enregistrez-en un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישום אחר כבר משתמש בקיצור הזה, כך שהוא לא יעבוד. הקליטו קיצור אחר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリですでに使われているため動作しません。ほかのショートカットを登録してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app já usa este atalho, então ele não vai funcionar. Grave outro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷键已被其他 App 占用，无法生效，请重新录制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание уже занято другим приложением и не сработает. Задайте другое."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інша програма вже використовує це скорочення, тому воно не працюватиме. Запишіть інше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 이미 사용 중인 단축키라 작동하지 않아요. 다른 단축키를 입력해 주세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra app usa già questa abbreviazione, quindi non funzionerà. Registrane un'altra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto zkratku už používá jiná aplikace, takže nebude fungovat. Zaznamenejte jinou."
          }
        }
      }
    },
    "Another device shows a request, and you check that the words on both screens match.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device shows a request, and you check that the words on both screens match."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät zeigt eine Anfrage, und du prüfst, ob auf beiden Bildschirmen dieselben Wörter stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo muestra una solicitud y compruebas que las palabras coincidan en ambas pantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil affiche une demande et vous vérifiez que les mots correspondent sur les deux écrans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר אחר מציג בקשה, ואתם בודקים שהמילים בשני המסכים תואמות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスにリクエストが表示されたら、両方の画面の単語が一致していることを確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dispositivo mostra uma solicitação, e você confirma se as palavras nas duas telas são iguais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备会显示验证请求，请核对两台屏幕上的词语是否一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство показывает запрос — вы сверяете слова на обоих экранах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший пристрій показує запит, а ви перевіряєте, що слова на обох екранах збігаються."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에 요청이 표시되면 양쪽 화면의 단어가 일치하는지 확인해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dispositivo mostra una richiesta e tu controlli che le parole su entrambi gli schermi coincidano."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druhé zařízení zobrazí požadavek a vy zkontrolujete, že slova na obou obrazovkách souhlasí."
          }
        }
      }
    },
