        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Sperre wird dein Verlauf unkenntlich gemacht, bis du dich mit %@ authentifizierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está bloqueado, tu historial se desenfoca hasta que te autenticas con %@."
