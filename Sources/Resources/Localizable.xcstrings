    "Clips you copy on an iPhone or iPad arrive through Universal Clipboard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips you copy on an iPhone or iPad arrive through Universal Clipboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips, die du auf deinem iPhone oder iPad kopierst, kommen über die Allgemeine Zwischenablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips que copias en un iPhone o iPad llegan mediante el Portapapeles universal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips copiés sur iPhone ou iPad arrivent via le Presse-papiers universel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים שתעתיקו ב-iPhone או ב-iPad מגיעים דרך הלוח האוניברסלי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneやiPadでコピーしたクリップはユニバーサルクリップボード経由で届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes copiados no iPhone ou iPad chegam pela Área de Transferência Universal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 iPhone 或 iPad 上拷贝的剪贴会通过通用剪贴板同步过来。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи с iPhone или iPad приходят через Универсальный буфер обмена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кліпи, скопійовані на iPhone чи iPad, надходять через Загальний буфер обміну."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이나 iPad에서 복사한 클립은 공통 클립보드를 통해 도착해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I clip copiati su iPhone o iPad arrivano tramite Appunti condivisi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy zkopírované na iPhonu nebo iPadu přicházejí přes Univerzální schránku."
          }
        }
      }
