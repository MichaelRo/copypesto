    "The backup also asks Pesto to delete history or keep less of it:": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup also asks Pesto to delete history or keep less of it:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup fordert Pesto außerdem auf, den Verlauf zu löschen oder weniger zu behalten:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad también pide a Pesto eliminar historial o conservar menos:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde demande aussi à Pesto de supprimer l’historique ou d’en garder moins :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיבוי גם מבקש מ-Pesto למחוק היסטוריה או לשמור פחות ממנה:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップでは、Pestoに履歴の削除や保持期間の短縮も指定されています："
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup também pede ao Pesto para apagar o histórico ou manter menos dele:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份还要求 Pesto 删除历史记录或减少保留量："
          }
        }
      }
    },
    "The clips in it stay in your history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clips in it stay in your history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Clips darin bleiben in deinem Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips que contiene siguen en tu historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips qu’elle contient restent dans votre historique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקטעים שבה יישארו בהיסטוריה שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中のクリップは履歴に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os clipes nela continuam no seu histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的剪贴仍会保留在历史记录中。"
          }
        }
      }
    },
    "The full list of what leaves it is on this pane.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full list of what leaves it is on this pane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Liste dessen, was ihn verlässt, steht in diesem Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista completa de lo que sale de él está en este panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste complète de ce qui en sort figure dans ce panneau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשימה המלאה של מה שיוצא ממנו מופיעה בחלונית זו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部へ送信される項目の全一覧はこの画面にあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista completa do que sai dele está neste painel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会离开设备的所有内容完整列于此面板中。"
          }
        }
      }
    },
    "The key shown when sync was turned on, or after Reset Sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key shown when sync was turned on, or after Reset Sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel, der beim Aktivieren von Sync oder nach „Sync zurücksetzen“ angezeigt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave mostrada al activar la sincronización o tras Restablecer sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé affichée lors de l’activation de la synchronisation ou après Réinitialiser la synchronisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח שהוצג בעת הפעלת הסנכרון, או לאחר איפוס סנכרון."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期をオンにしたとき、または「同期をリセット」の後に表示されたキー。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave exibida ao ativar a sincronização ou após Redefinir Sincronização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启同步或“重置同步”后显示的密钥。"
          }
        }
      }
    },
    "These rules were made by a newer version of Pesto, so they can’t be edited here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rules were made by a newer version of Pesto, so they can’t be edited here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Regeln wurden mit einer neueren Version von Pesto erstellt und können hier nicht bearbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas reglas fueron creadas por una versión más reciente de Pesto, así que no se pueden editar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces règles ont été créées par une version plus récente de Pesto et ne peuvent pas être modifiées ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כללים אלה נוצרו בגרסה חדשה יותר של Pesto, ולכן לא ניתן לערוך אותם כאן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのルールは新しいバージョンのPestoで作成されたため、ここでは編集できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas regras foram criadas por uma versão mais recente do Pesto, portanto não podem ser editadas aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些规则由更新版本的 Pesto 创建，无法在此处编辑。"
          }
        }
      }
    },
    "These work while the shelf is open. They are fixed, so they never clash with your own shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These work while the shelf is open. They are fixed, so they never clash with your own shortcuts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese funktionieren bei geöffneter Ablage. Sie sind fest belegt und kollidieren nie mit deinen Kurzbefehlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionan mientras el estante está abierto. Son fijos, así que nunca chocan con tus propios atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils fonctionnent quand l’étagère est ouverte. Ils sont fixes et n’entrent jamais en conflit avec vos raccourcis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלה פועלים כשהמדף פתוח. הם קבועים, כך שלעולם לא יתנגשו עם הקיצורים שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルフを開いている間に使えます。固定のため、自分のショートカットと競合しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes funcionam com a estante aberta. São fixos, para nunca entrarem em conflito com seus atalhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些快捷键在剪贴架打开时生效。它们是固定的，不会与你自己的快捷键冲突。"
          }
        }
      }
    },
    "They cannot be pasted or backed up. A backup made earlier can still bring a readable copy back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They cannot be pasted or backed up. A backup made earlier can still bring a readable copy back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können nicht eingesetzt oder gesichert werden. Ein früheres Backup kann dennoch eine lesbare Kopie zurückbringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden pegar ni incluir en copias de seguridad. Una copia anterior aún puede recuperar una versión legible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne peuvent pas être collés ni sauvegardés. Une sauvegarde antérieure peut encore restaurer une copie lisible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להדביק או לגבות אותם. גיבוי מוקדם יותר עדיין יכול לשחזר עותק קריא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペーストやバックアップはできません。以前のバックアップから読み取り可能なコピーを復元することは可能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles não podem ser colados nem incluídos em backup. Um backup feito antes ainda pode trazer uma cópia legível de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们无法粘贴或备份。较早创建的备份仍可恢复可读副本。"
          }
        }
      }
    },
    "Thinking…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking…"
          }
        },
        "de": {
