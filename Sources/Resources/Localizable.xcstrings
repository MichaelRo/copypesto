    "%lld clips cannot be opened, so the backup was left as it is.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clip cannot be opened, so the backup was left as it is."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clips cannot be opened, so the backup was left as it is."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Clip konnte nicht geöffnet werden, daher blieb das Backup unverändert."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Clips konnten nicht geöffnet werden, daher blieb das Backup unverändert."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "No se pudo abrir %lld clip, por lo que la copia de seguridad quedó sin cambios."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "No se pudieron abrir %lld clips, por lo que la copia de seguridad quedó sin cambios."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Impossible d’ouvrir %lld clip ; la sauvegarde a été conservée telle quelle."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Impossible d’ouvrir %lld clips ; la sauvegarde a été conservée telle quelle."
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "לא ניתן לפתוח קטע %lld, ולכן הגיבוי נשאר כפי שהוא."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "לא ניתן לפתוח %lld קטעים, ולכן הגיבוי נשאר כפי שהוא."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld件のクリップを開けなかったため、バックアップはそのまま残されました。"
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clipe não pôde ser aberto, então o backup foi mantido como está."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clipes não puderam ser abertos, então o backup foi mantido como está."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "有 %lld 条剪贴无法打开，因此备份保持原样未动。"
                }
              }
            }
          }
        }
      }
    },
