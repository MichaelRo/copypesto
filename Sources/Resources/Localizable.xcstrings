    "A smart collection fills itself with the clips that match, and keeps filling as you copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A smart collection fills itself with the clips that match, and keeps filling as you copy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine intelligente Sammlung füllt sich mit passenden Clips und wächst beim Kopieren automatisch weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una colección inteligente se llena con los clips que coinciden y sigue llenándose al copiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une collection intelligente se remplit avec les clips correspondants et continue au fil de vos copies."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוסף חכם מתמלא בקטעים התואמים, וממשיך להתעדכן בכל העתקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートコレクションには条件に合うクリップが集まり、コピーするたびに自動で追加されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma coleção inteligente se preenche com os clipes correspondentes e continua se preenchendo conforme você copia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能合集会自动收录匹配的剪贴，并在你持续拷贝时不断更新。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смарт-коллекция сама собирает подходящие записи и пополняется по мере копирования."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Смартколекція сама збирає кліпи за правилами й оновлюється щоразу, коли ви копіюєте."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 컬렉션은 조건에 맞는 클립으로 채워지며, 복사할 때마다 자동으로 업데이트돼요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una raccolta smart si riempie con i clip che corrispondono e continua ad aggiornarsi mentre copi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chytrá kolekce se naplní odpovídajícími klipy a průběžně doplňuje všechno, co zkopírujete."
          }
        }
      }
    },
