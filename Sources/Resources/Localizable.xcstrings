    },
    "Type {{date}} for an automatic fill or {{name}} for a fill-in question, or pick from the menus above.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type {{date}} for an automatic fill or {{name}} for a fill-in question, or pick from the menus above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe {{date}} para un relleno automático o {{name}} para una pregunta, o elige en los menús de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez {{date}} pour un champ automatique ou {{name}} pour une question, ou choisissez ci-dessus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib {{date}} für automatisches Ausfüllen oder {{name}} für eine Frage ein, oder wähle oben aus den Menüs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
