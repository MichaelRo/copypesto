    "⌘S on a picture saves it here without asking; a name already there gets a number.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S on a picture saves it here without asking; a name already there gets a number."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S bei einem Bild sichert es hier ohne Rückfrage; ein bereits vorhandener Name erhält eine Nummer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S en una imagen la guarda aquí sin preguntar; si el nombre ya existe, añade un número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S sur une image l’enregistre ici directement ; si le nom existe déjà, un numéro est ajouté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S על תמונה שומר אותה כאן בלי לשאול; אם שם כזה כבר קיים, מתווסף לו מספר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像で⌘Sを押すと確認なしでここに保存されます。同名のファイルがある場合は番号が付きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S em uma imagem a salva aqui sem perguntar; se o nome já existir, recebe um número."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图片上按 ⌘S 会直接保存至此，不再询问；若已有同名文件则自动编号。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S на картинке сразу сохранит её сюда; при совпадении имени добавится номер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S на зображенні зберігає його сюди без запитань; якщо назва вже існує, додається номер."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지에 ⌘S를 누르면 묻지 않고 여기에 저장돼요. 같은 이름이 있으면 뒤에 숫자가 붙어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S su un'immagine la salva qui senza chiedere; se il nome esiste già, aggiunge un numero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘S u obrázku ho sem uloží bez ptaní; pokud už název existuje, přidá se číslo."
          }
        }
      }
    },
