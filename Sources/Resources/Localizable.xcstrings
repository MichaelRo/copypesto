          "stringUnit": {
            "state": "translated",
            "value": "Pesto %@ ist bereit und wird beim Beenden installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto %@ está listo. Se instalará al salir de Pesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto %@ est prêt. Il s’installera à la fermeture de Pesto."
          }
