    "What Pesto keeps, for how long, and where your copies live.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Pesto keeps, for how long, and where your copies live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Pesto behält, wie lange und wo deine Kopien liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué guarda Pesto, durante cuánto tiempo y dónde se guardan tus copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Pesto conserve, pendant combien de temps et où sont stockées vos copies."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה Pesto שומרת, לכמה זמן, ואיפה ההעתקות שלך נשמרות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoが何を、どのくらい、どこに保存するか。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o Pesto guarda, por quanto tempo e onde suas cópias ficam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto 保留哪些内容、保留多久，以及你的拷贝保存在哪里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что хранит Pesto, как долго и где находятся ваши записи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що Pesto зберігає, як довго і де живуть ваші копії."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesto가 무엇을 얼마나 오래, 어디에 보관하는지 확인하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa conserva Pesto, per quanto tempo e dove vivono le tue copie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co Pesto uchovává, jak dlouho a kde jsou vaše kopie uložené."
          }
        }
      }
    },
