        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda até você ver o conteúdo do backup e confirmar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你查看备份内容并确认之前，不会更改任何内容。"
          }
        }
      }
    },
    "Nothing is deleted. Clips are merged both ways, and Pesto stays usable while it runs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. Clips are merged both ways, and Pesto stays usable while it runs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gelöscht. Clips werden in beide Richtungen zusammengeführt, und Pesto bleibt dabei nutzbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada. Los clips se combinan en ambos sentidos y Pesto sigue usable durante el proceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé. Les clips sont fusionnés dans les deux sens et Pesto reste utilisable pendant l’opération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר לא נמחק. הקטעים מתמזגים לשני הכיוונים, ו-Pesto נשארת שמישה בזמן הפעולה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されるものはありません。クリップは双方向に統合され、実行中もPestoを使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é apagado. Os clipes são mesclados nos dois sentidos e o Pesto continua utilizável."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会删除任何内容。剪贴会双向合并，运行期间 Pesto 仍可正常使用。"
          }
        }
      }
    },
    "Nothing is deleted. Clips are merged both ways, and the shelf stays usable while it runs.": {
