    "%@ shows a request from this %@. Confirm both screens show the same words.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ shows a request from this %2$@. Confirm both screens show the same words."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zeigt eine Anfrage von diesem %2$@. Bestätige, dass beide Bildschirme dieselben Wörter zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ muestra una solicitud de este %2$@. Confirma que ambas pantallas muestran las mismas palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ affiche une demande de cet appareil (%2$@). Vérifiez que les deux écrans affichent les mêmes mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ מציג בקשה מ-%2$@ זה. יש לוודא שבשני המסכים מופיעות אותן מילים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にこの%2$@からのリクエストが表示されています。両方の画面に同じ単語が表示されていることを確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mostra uma solicitação deste %2$@. Confirme se as duas telas mostram as mesmas palavras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 显示了来自此 %2$@ 的请求。请确认两台屏幕上显示的词语相同。"
          }
        }
      }
    },
