    "On: a new version installs when Pesto quits. Off: Pesto asks first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: a new version installs when Pesto quits. Off: Pesto asks first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein: Neue Versionen werden beim Beenden installiert. Aus: Pesto fragt zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: la nueva versión se instala al salir de Pesto. Desactivado: Pesto pregunta antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : une nouvelle version s’installe à la fermeture de Pesto. Désactivé : Pesto demande d’abord confirmation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל: גרסה חדשה מותקנת ביציאה מ-Pesto. כבוי: Pesto שואלת קודם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン：Pestoの終了時に新しいバージョンをインストールします。オフ：事前に確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado: a nova versão é instalada ao sair do Pesto. Desativado: o Pesto pergunta antes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启：退出 Pesto 时安装新版本。关闭：Pesto 会先询问。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкл.: новая версия ставится при выходе из Pesto. Выкл.: Pesto сначала спросит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнено: нова версія встановлюється після виходу з Pesto. Вимкнено: Pesto спершу запитує."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬: Pesto를 종료할 때 새 버전을 설치해요. 끔: 먼저 설치 여부를 물어봐요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo: una nuova versione si installa alla chiusura di Pesto. Disattivo: Pesto chiede prima."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuto: nová verze se nainstaluje po ukončení Pesta. Vypnuto: Pesto se nejdřív zeptá."
          }
        }
      }
    },
