    "It is removed from your history too. A backup made earlier can still bring it back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is removed from your history too. A backup made earlier can still bring it back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird auch aus deinem Verlauf entfernt. Ein früheres Backup kann ihn noch zurückbringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se elimina de tu historial. Una copia de seguridad anterior aún puede recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est aussi supprimé de votre historique. Une sauvegarde antérieure peut encore le rétablir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא מוסר גם מההיסטוריה שלך. גיבוי מוקדם יותר עדיין יכול להחזיר אותו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴からも削除されます。以前作成したバックアップから復元することは可能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele também é removido do seu histórico. Um backup feito antes ainda pode trazê-lo de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它也会从历史记录中移除。较早创建的备份仍可将其恢复。"
          }
        }
      }
    },
    "It needs Accessibility, which is not granted yet (see Permissions, below).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs Accessibility, which is not granted yet (see Permissions, below)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür sind Bedienungshilfen erforderlich, die noch nicht erlaubt wurden (siehe Berechtigungen unten)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita acceso de Accesibilidad, que aún no está concedido (consulta Permisos abajo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès d’accessibilité est requis et n’est pas encore accordé (voir Autorisations ci-dessous)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דרושה גישת נגישות, שעדיין לא אושרה (ראו ״הרשאות״ למטה)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの許可が必要です（下の「アクセス権」を参照）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de Acessibilidade, que ainda não foi concedida (veja Permissões abaixo)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限，目前尚未授予（见下方的“权限”）。"
          }
        }
      }
    },
