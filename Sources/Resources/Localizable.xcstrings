    "Clips past the new limit are deleted now. Pinned clips stay. It can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips past the new limit are deleted now. Pinned clips stay. It can’t be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips über dem neuen Limit werden jetzt gelöscht. Angeheftete Clips bleiben. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips que superen el nuevo límite se eliminan ahora. Los fijados permanecen. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips au-delà de la nouvelle limite sont supprimés maintenant. Les clips épinglés restent. C’est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים שמעבר למגבלה החדשה נמחקים כעת. קטעים מוצמדים נשמרים. לא ניתן לבטל פעולה זו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい上限を超えるクリップは今すぐ削除されます。ピン留めは残ります。この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes além do novo limite serão apagados agora. Clipes fixados permanecem. Não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出新上限的剪贴将立即删除，置顶剪贴会保留。此操作不可撤销。"
          }
        }
      }
    },
