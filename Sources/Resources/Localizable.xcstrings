    "Your pinned and recent text clips appear here. Clips with secrets never do.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pinned and recent text clips appear here. Clips with secrets never do."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine angehefteten und letzten Textclips erscheinen hier. Clips mit Geheimnissen nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen tus clips de texto fijados y recientes. Los que contienen secretos nunca se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos clips texte épinglés et récents apparaissent ici. Ceux contenant des secrets n’y apparaissent jamais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעי הטקסט המוצמדים והאחרונים שלך מופיעים כאן. קטעים עם סודות — אף פעם לא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めしたクリップや最近のテキストクリップがここに表示されます。シークレットを含むクリップは表示されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus clipes de texto fixados e recentes aparecem aqui. Clipes com segredos nunca aparecem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定的剪贴和最近的文本剪贴会显示在这里，包含机密的剪贴绝不会出现。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь отображаются закреплённые и недавние текстовые записи. Записи с секретами сюда не попадают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являються ваші закріплені та недавні текстові кліпи. Кліпи із секретами — ніколи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 클립과 최근 텍스트 클립이 여기에 나타나요. 비밀 정보가 든 클립은 절대 표시되지 않아요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui appaiono i clip di testo fissati e recenti. Quelli con segreti non appaiono mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazují vaše připnuté a nedávné textové klipy. Klipy s tajnými údaji nikdy."
          }
        }
      }
    },
