    "Sync needs your history, which did not open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync needs your history, which did not open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync benötigt deinen Verlauf, der sich nicht öffnen ließ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización necesita tu historial, que no se pudo abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation nécessite votre historique, mais celui-ci n’a pas pu s’ouvrir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסנכרון דורש את ההיסטוריה שלך, שלא נפתחה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期には履歴が必要ですが、開けませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização precisa do seu histórico, que não abriu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步需要访问历史记录，但未能打开。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для синхронизации нужна история, но её не удалось открыть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізації потрібна історія, але її не вдалося відкрити."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화하려면 기록을 열어야 하는데 열지 못했어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione richiede la cronologia, che non si è aperta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace potřebuje vaši historii, kterou se nepodařilo otevřít."
          }
        }
      }
    },
    "Templates to begin with. Each fills in the date or time when you paste it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates to begin with. Each fills in the date or time when you paste it."
          }
        },
        "de": {
          "stringUnit": {
