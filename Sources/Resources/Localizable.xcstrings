    "On: a new version installs when Pesto quits. Off: Pesto asks first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: a new version installs when Pesto quits. Off: Pesto asks first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein: Eine neue Version wird beim Beenden von Pesto installiert. Aus: Pesto fragt zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: la nueva versión se instala al salir de Pesto. Desactivado: Pesto pregunta antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : une nouvelle version s’installe à la fermeture de Pesto. Désactivé : Pesto demande d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל: גרסה חדשה מותקנת ביציאה מ-Pesto. כבוי: Pesto שואלת קודם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン：Pestoの終了時に新しいバージョンをインストールします。オフ：事前に確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado: uma nova versão é instalada ao sair do Pesto. Desativado: o Pesto pergunta antes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启：退出 Pesto 时安装新版本。关闭：Pesto 会先询问。"
          }
        }
      }
    },
