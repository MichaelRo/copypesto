    "Glass shows a little of your desktop. Solid is plain and the same on every desktop.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass shows a little of your desktop. Solid is plain and the same on every desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glas lässt deinen Schreibtisch leicht durchscheinen. Deckend ist schlicht und auf jedem Schreibtisch gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cristal deja entrever el escritorio. Sólido es opaco e igual en todos los escritorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verre laisse entrevoir votre Bureau. Uni reste sobre et identique sur chaque Bureau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זכוכית מציגה מעט משולחן העבודה. אטום הוא פשוט ואחיד בכל שולחן עבודה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラスはデスクトップがわずかに透けます。ソリッドはどのデスクトップでも均一で落ち着いた表示です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidro mostra um pouco da sua Mesa. Sólido é uniforme e igual em todas as Mesas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玻璃效果会微微透出桌面背景。纯色则在每个桌面上都保持一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стекло слегка просвечивает рабочий стол. Сплошной фон выглядит одинаково везде."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скло трохи просвічує робочий стіл. Суцільний фон однаковий на всіх екранах."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 스타일은 데스크탑 배경이 은은하게 비치고, 단색은 모든 화면에서 깔끔하게 동일해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetro lascia intravedere la scrivania. Solido è uniforme e uguale su ogni scrivania."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sklo nechává jemně prosvítat plochu. Plné pozadí je jednolité a stejné na každé ploše."
          }
        }
      }
    },
    "Goes with the theme. Change it on its own any time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes with the theme. Change it on its own any time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt zum Thema. Du kannst sie jederzeit separat ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina con el tema. Puedes cambiarlo por separado cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le thème choisi. Modifiable séparément à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתאים לערכת הנושא. אפשר לשנות בנפרד בכל עת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマに合わせた設定です。いつでも個別に変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina com o tema. Mude separadamente quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随主题配色变化，也可随时单独更改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подбирается под тему. Можно изменить отдельно в любой момент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасує до теми. Можна змінити окремо будь-коли."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마에 맞춰 바뀌어요. 언제든 따로 바꿀 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue il tema. Puoi cambiarlo da solo quando vuoi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladí s motivem. Kdykoli ho můžete změnit samostatně."
          }
        }
      }
    },
