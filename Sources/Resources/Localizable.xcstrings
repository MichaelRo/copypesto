    "In Pesto, open Settings and turn on Insert from Pesto in other apps.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Pesto, open Settings and turn on Insert from Pesto in other apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Pesto die Einstellungen und aktiviere „Aus Pesto in anderen Apps einfügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Pesto, abre Ajustes y activa Insertar desde Pesto en otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Pesto, ouvrez Réglages et activez Insérer depuis Pesto dans d’autres apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-Pesto, פתחו הגדרות והפעילו את ״הוספה מ-Pesto ביישומים אחרים״."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestoで「設定」を開き、「他のアプリでPestoから挿入」をオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Pesto, abra Ajustes e ative Inserir do Pesto em outros apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Pesto 中打开“设置”，开启“在其他 App 中从 Pesto 插入”。"
          }
        }
      }
    },
    "Insert your clips in any app. Clips only, never passwords. You switch Pesto on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert your clips in any app. Clips only, never passwords. You switch Pesto on in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deine Clips in jeder App ein. Nur Clips, niemals Passwörter. Aktiviere Pesto in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta tus clips en cualquier app. Solo clips, nunca contraseñas. Activa Pesto en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérez vos clips dans toute app. Des clips uniquement, jamais de mots de passe. Activez Pesto dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את הקטעים שלכם בכל יישום. קטעים בלבד, לעולם לא סיסמאות. הפעילו את Pesto בהגדרות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリにもクリップを挿入できます。クリップのみで、パスワードは対象外です。設定でPestoをオンにします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira seus clipes em qualquer app. Apenas clipes, nunca senhas. Você ativa o Pesto nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中插入你的剪贴。仅限剪贴内容，绝不涉及密码。请在“设置”中开启 Pesto。"
          }
        }
      }
    },
    "Install updates automatically": {
