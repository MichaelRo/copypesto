    "Kept on this Mac, from the suggestions the shelf has shown. Nothing is sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this Mac, from the suggestions the shelf has shown. Nothing is sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac gespeichert, aus den auf der Ablage gezeigten Vorschlägen. Nichts wird irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en este Mac, a partir de las sugerencias mostradas en el estante. No se envía nada a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé sur ce Mac, à partir des suggestions affichées sur l’étagère. Rien n’est envoyé nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר ב-Mac זה, מתוך ההצעות שהוצגו במדף. דבר לא נשלח החוצה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェルフに表示された提案をもとにこのMac上に保存されます。外部へは一切送信されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido neste Mac, a partir das sugestões mostradas na estante. Nada é enviado para lugar nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据剪贴架显示过的建议保存在此 Mac 上。不会向任何地方发送数据。"
          }
        }
      }
    },
    "Keys that work in every app, and the keys that work on the shelf.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys that work in every app, and the keys that work on the shelf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten, die in jeder App funktionieren, und Tasten auf der Ablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas que funcionan en cualquier app y teclas que funcionan en el estante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches valables dans toute app et touches propres à l’étagère."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקשים שעובדים בכל יישום, ומקשים שעובדים במדף."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも使えるキーと、シェルフ上で使えるキー。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas que funcionam em qualquer app e teclas que funcionam na estante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有 App 中生效的快捷键，以及在剪贴架上生效的快捷键。"
          }
        }
      }
    },
