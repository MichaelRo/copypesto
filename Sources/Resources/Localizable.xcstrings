    "Another app already uses this, so it will not work. Record a different shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app already uses this, so it will not work. Record a different shortcut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App verwendet dies bereits, daher funktioniert es nicht. Nimm einen anderen Kurzbefehl auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ya usa este atajo, así que no funcionará. Graba uno distinto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise déjà ce raccourci ; il ne fonctionnera pas. Enregistrez-en un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישום אחר כבר משתמש בקיצור הזה, כך שהוא לא יעבוד. הקליטו קיצור אחר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがすでに使用しているため機能しません。別のショートカットを登録してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app já usa este atalho, então ele não funcionará. Grave outro atalho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App 已占用此快捷键，因此无法生效。请录制其他快捷键。"
          }
        }
      }
    },
    "Another device shows a request, and you check that the words on both screens match.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device shows a request, and you check that the words on both screens match."
          }
