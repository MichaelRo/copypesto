<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Only for a release signed with SYNC_PROFILE and WIDGET_PROFILE (ADR 0059): the extension's own profile
         authorizes these. It holds the widget's Keychain group alone, never the app's own, so it can open the widget
         snapshot's key and nothing else. Every other build signs the extension with PestoControls.entitlements. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>$(DEVELOPMENT_TEAM).net.copypesto.pesto.controls</string>
    <key>com.apple.developer.team-identifier</key>
    <string>$(DEVELOPMENT_TEAM)</string>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.net.copypesto.pesto</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(DEVELOPMENT_TEAM).net.copypesto.pesto.widget</string>
    </array>
</dict>
</plist>
