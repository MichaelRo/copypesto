# Build artifacts
.build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
xcuserdata/

# Xcode project (regenerated by xcodegen)
Pesto.xcodeproj/

# SwiftPM
.swiftpm/
Package.resolved

# macOS
.DS_Store
*.swp
*~

# Local credentials / secrets (never commit)
*.p12
*.cer
*.mobileprovision
# exportOptions.plist is tracked — it uses $(APPLE_TEAM_ID) placeholder, no hardcoded credentials.
notarization.json
AuthKey_*.p8

# CloudKit local store dumps
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Test output
*.xcresult/
TestResults/
coverage.lcov
*.profdata

# Snapshot test failures (committed snapshots stay)
__Snapshots__/**/*.diff.png
FailureDiffs/

# Tooling caches
.swiftlint.cache
.swiftformat.cache

# JetBrains / VS Code / Cursor
.idea/
.vscode/
*.iml

# Local-only experiments
scratch/
TODO.local.md

# Skill eval workspaces (benchmarking artifacts, not app code)
*-workspace/

# Claude Code — commit shared config (.claude/settings.json, commands, skills),
# ignore local/personal overrides (don't rely on a per-machine global gitignore)
.claude/settings.local.json
.claude/launch.json
.claude/scheduled_tasks.*
.claude/*.local.json
.claude/plans/
.claude/sessions/
.claude/.cache/
CLAUDE.local.md

# Coverage output from swift test
*.profraw
