    "It is removed from your history too. A backup made earlier can still bring it back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is removed from your history too. A backup made earlier can still bring it back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird auch aus deinem Verlauf entfernt. Ein früheres Backup kann ihn jedoch wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se elimina de tu historial. Una copia de seguridad anterior aún puede recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est aussi supprimé de votre historique. Une sauvegarde antérieure peut encore le restaurer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא נמחק גם מההיסטוריה שלך. גיבוי מוקדם יותר עדיין יכול להחזיר אותו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴からも削除されます。以前作成したバックアップから復元することは可能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele também sai do seu histórico. Um backup anterior ainda pode trazê-lo de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它也会从历史记录中移除。较早创建的备份仍可将其恢复。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она удалится и из истории. Ранее созданная резервная копия сможет её вернуть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його також видалено з вашої історії. Попередня резервна копія все ще може повернути його."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에서도 함께 지워져요. 이전에 만든 백업이 있다면 다시 복원할 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimosso anche dalla cronologia. Un backup precedente può comunque recuperarlo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebere se i z vaší historie. Dříve vytvořená záloha ho stále dokáže vrátit."
          }
        }
      }
    },
    "It needs Accessibility, which is not granted yet (see Permissions, below).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs Accessibility, which is not granted yet (see Permissions, below)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür ist der Zugriff auf die Bedienungshilfen nötig, der noch nicht erteilt wurde (siehe Berechtigungen unten)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita permiso de Accesibilidad, que aún no está activado (consulta Permisos abajo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Accessibilité est requise et n’est pas encore accordée (voir Autorisations ci-dessous)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דרושה גישת נגישות, שעדיין לא אושרה (ראו ״הרשאות״ למטה)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの許可が必要です（下の「アクセス権」を参照）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de Acessibilidade, que ainda não foi concedida (veja Permissões abaixo)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限，目前尚未授予（见下方的“权限”）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен Универсальный доступ — он ещё не выдан (см. «Разрешения» ниже)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до Доступності, який ще не надано (див. Дозволи нижче)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 필요한데 아직 허용되지 않았어요(아래 권한 항목 참고)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Accessibilità, non ancora consentita (vedi Permessi sotto)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje oprávnění Zpřístupnění, které ještě není uděleno (viz Oprávnění níže)."
          }
        }
      }
    },
