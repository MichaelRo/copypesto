    "Turn it on in System Settings, or join with a recovery key instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in System Settings, or join with a recovery key instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere es in den Systemeinstellungen oder tritt stattdessen mit einem Wiederherstellungsschlüssel bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes del Sistema o únete con una clave de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans Réglages Système ou utilisez une clé de récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את זה בהגדרות המערכת, או הצטרפו עם מפתח שחזור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」でオンにするか、復旧キーで参加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative nos Ajustes do Sistema ou entre usando uma chave de recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”中开启，或改用恢复密钥加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите её в Системных настройках или подключитесь по ключу восстановления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть його в Системних параметрах або приєднайтеся за допомогою ключа відновлення."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 켜거나, 대신 복구 키로 연결하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo in Impostazioni di Sistema oppure unisciti con una chiave di recupero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte to v Nastavení systému, nebo se připojte pomocí klíče pro obnovení."
          }
        }
      }
    },
    "Turn it on in the Settings app, or join with a recovery key instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in the Settings app, or join with a recovery key instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere es in den Einstellungen oder tritt stattdessen mit einem Wiederherstellungsschlüssel bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en la app Ajustes o únete con una clave de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans l’app Réglages ou utilisez une clé de récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את זה ביישום ״הגדרות״, או הצטרפו עם מפתח שחזור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」アプリでオンにするか、復旧キーで参加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative no app Ajustes ou entre usando uma chave de recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”App 中开启，或改用恢复密钥加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите её в приложении «Настройки» или подключитесь по ключу восстановления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть його в програмі «Параметри» або приєднайтеся за допомогою ключа відновлення."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 앱에서 켜거나, 대신 복구 키로 연결하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo nell'app Impostazioni oppure unisciti con una chiave di recupero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte to v aplikaci Nastavení, nebo se připojte pomocí klíče pro obnovení."
          }
        }
      }
    },
    "Turning sync off keeps this device in your sync, so turning it on again needs nothing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning sync off keeps this device in your sync, so turning it on again needs nothing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Sync ausschaltest, bleibt dieses Gerät verknüpft – zum erneuten Einschalten musst du nichts weiter tun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la sincronización mantiene este dispositivo vinculado, así que volver a activarla no requiere nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver la synchronisation laisse cet appareil associé ; la réactiver ne nécessitera aucune configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיבוי הסנכרון משאיר את המכשיר הזה מחובר לסנכרון שלך, כך שהפעלה מחדש לא דורשת שום דבר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期をオフにしてもこのデバイスは同期グループに残るため、再びオンにする際に再設定は不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar a sincronização mantém este dispositivo vinculado, então reativar não exige nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步会保留此设备的同步配置，重新开启时无需再次设置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выключении устройство остаётся привязанным — повторное включение ничего не потребует."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнення синхронізації залишає цей пристрій у групі, тож повторне ввімкнення не потребуватиме нічого зайвого."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 꺼도 이 기기는 동기화 그룹에 남아 있어, 나중에 다시 켤 때 별도 설정이 필요 없어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivando la sincronizzazione il dispositivo resta collegato, quindi riattivarla non richiede nulla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnutí synchronizace ponechá toto zařízení spárované, takže při opětovném zapnutí není nic potřeba."
          }
        }
      }
    },
    "Two choices, both optional. Settings has them later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two choices, both optional. Settings has them later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Optionen, beide freiwillig. Du findest sie später auch in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos opciones, ambas opcionales. Podrás cambiarlas más adelante en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux choix, tous deux facultatifs. Vous les retrouverez plus tard dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי בחירות, שתיהן אופציונליות. אפשר לשנות אותן גם אחר כך בהגדרות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この2つはどちらも任意です。後から「設定」で変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas opções, ambas opcionais. Você pode mudar depois em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个选项均为可选，稍后也可在“设置”中调整。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два необязательных параметра. Потом их всегда можно найти в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два варіанти, обидва необов’язкові. Їх можна змінити пізніше в Параметрах."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 가지 선택 사항이에요. 나중에 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due scelte, entrambe facoltative. Le ritrovi in Impostazioni."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvě volby, obě nepovinné. Později je najdete v Nastavení."
          }
        }
      }
    },
