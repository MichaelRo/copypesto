    "All, Pinned, and Snippets (pinned clips with placeholders like {{date}}) appear first, followed by your collections.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All, Pinned, and Snippets (pinned clips with placeholders like {{date}}) appear first, followed by your collections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos, Fijados y Fragmentos (clips fijados con marcadores como {{date}}) aparecen primero, seguidos de tus colecciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous, Épinglés et Extraits (clips épinglés avec des champs comme {{date}}) apparaissent en premier, suivis de vos collections."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, Angeheftet und Snippets (angeheftete Clips mit Platzhaltern wie {{date}}) erscheinen zuerst, gefolgt von deinen Sammlungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「すべて」「ピン留め」「スニペット」（{{date}} などのプレースホルダー付き）が最初に表示され、その後にコレクションが続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“全部”“置顶”和“片段”（含 {{date}} 等占位符的置顶剪贴）会先显示，其后是你的收藏集。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos, Fixados e Trechos (clipes fixados com campos como {{date}}) aparecem primeiro, seguidos das suas coleções."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״הכל״, ״מוצמדים״ ו״קטעי טקסט״ (קטעים מוצמדים עם מצייני מיקום כמו {{date}}) מופיעים ראשונים, ואחריהם האוספים שלך."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Все», «Закреплённые» и «Сниппеты» (закреплённые записи с заполнителями вроде {{date}}) показываются первыми, затем ваши коллекции."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Усі», «Закріплені» та «Сніпети» (закріплені кліпи із заповнювачами на кшталт {{date}}) йдуть першими, далі — ваші колекції."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체, 고정됨, 스니펫({{date}} 같은 자리 표시자가 있는 고정 클립)이 먼저 표시되고 그 뒤에 컬렉션이 나옵니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti, Fissati e Frammenti (clip fissati con segnaposto come {{date}}) compaiono per primi, seguiti dalle tue raccolte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, Připnuté a Úryvky (připnuté klipy se zástupnými symboly jako {{date}}) se zobrazí jako první, po nich vaše sbírky."
          }
        }
      }
    },
