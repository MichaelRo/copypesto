    "Paste fills the clipboard placeholder. Without it, that placeholder stays empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste fills the clipboard placeholder. Without it, that placeholder stays empty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einsetzen füllt den Zwischenablage-Platzhalter. Ohne bleibt dieser leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar rellena el marcador del portapapeles. Sin él, ese marcador queda vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller remplit le paramètre du presse-papiers. Sans cela, ce paramètre reste vide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבקה ממלאת את ממלא המקום של הלוח. בלעדיה, ממלא מקום זה נשאר ריק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペーストでクリップボードのプレースホルダが埋まります。ない場合は空のままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colar preenche o espaço reservado da área de transferência. Sem isso, ele fica vazio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴权限用于填入剪贴板占位符。若不授予，该占位符将保持为空。"
          }
        }
      }
