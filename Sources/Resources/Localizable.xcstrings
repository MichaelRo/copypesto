    "Delete this collection? The clips in it stay in your history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this collection? The clips in it stay in your history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sammlung löschen? Die Clips darin bleiben in deinem Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta colección? Los clips que contiene siguen en tu historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette collection ? Les clips qu’elle contient restent dans votre historique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק אוסף זה? הקטעים שבו יישארו בהיסטוריה שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコレクションを削除しますか？中のクリップは履歴に残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta coleção? Os clipes nela continuam no seu histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除此合集吗？其中的剪贴仍会保留在你的历史记录中。"
          }
        }
      }
    },
    "Deleting a clip on one device deletes it on all. Sync is not a backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a clip on one device deletes it on all. Sync is not a backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen eines Clips auf einem Gerät löscht ihn überall. Sync ist kein Backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar un clip en un dispositivo lo elimina en todos. La sincronización no es una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un clip sur un appareil le supprime partout. La synchronisation n’est pas une sauvegarde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת קטע במכשיר אחד מוחקת אותו בכולם. סנכרון אינו גיבוי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの端末でクリップを削除するとすべての端末から削除されます。同期はバックアップではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar um clipe em um dispositivo o apaga em todos. Sincronização não é backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一台设备上删除剪贴会同步删除所有设备上的该剪贴。同步不是备份。"
          }
        }
      }
    },
    "Describe Image needs a model that can read pictures, which this Mac’s does not have yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe Image needs a model that can read pictures, which this Mac’s does not have yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bild beschreiben“ benötigt ein Modell, das Bilder lesen kann; dieses Mac-Modell unterstützt das noch nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describir imagen necesita un modelo que pueda leer imágenes, y el de este Mac aún no lo tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrire l’image nécessite un modèle capable de lire les images, dont ce Mac ne dispose pas encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״תיאור תמונה״ דורש מודל שמסוגל לקרוא תמונות, מה שעדיין אין במכשיר Mac זה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「画像を説明」には画像を読み取れるモデルが必要ですが、このMacのモデルにはまだ対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrever Imagem precisa de um modelo que leia imagens, o que este Mac ainda não tem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“描述图片”需要能够识图的模型，此 Mac 目前尚不支持。"
          }
        }
      }
    },
