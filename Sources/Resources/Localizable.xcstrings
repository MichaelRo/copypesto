    "iCloud can see how many devices you have, file sizes and when files change, not your clips.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud can see how many devices you have, file sizes and when files change, not your clips."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud kann sehen, wie viele Geräte du hast, die Dateigrößen und wann sich Dateien ändern – nicht deine Clips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud puede ver cuántos dispositivos tienes, el tamaño de los archivos y cuándo cambian, pero no tus clips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud peut voir le nombre de vos appareils, la taille des fichiers et leur date de modification, pas vos clips."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏iCloud יכול לראות כמה מכשירים יש לך, את גודל הקבצים ומתי הם משתנים — לא את הקטעים שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudが確認できるのは端末数、ファイルサイズ、更新日時のみで、クリップの中身は見えません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud pode ver quantos dispositivos você tem, tamanhos de arquivos e quando mudam, não seus clipes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 能看到你的设备数量、文件大小和更改时间，但无法读取你的剪贴内容。"
          }
        }
      }
    },
    "macOS will also ask whether Pesto may read what you copy. Choose Allow, or it cannot remember.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will also ask whether Pesto may read what you copy. Choose Allow, or it cannot remember."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt außerdem, ob Pesto lesen darf, was du kopierst. Wähle „Erlauben“, sonst kann es nichts merken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS también preguntará si Pesto puede leer lo que copias. Elige Permitir, o no podrá recordarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demandera aussi si Pesto peut lire ce que vous copiez. Choisissez Autoriser, sinon il ne pourra rien retenir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS ישאל גם אם Pesto רשאית לקרוא את מה שאתם מעתיקים. בחרו ״אפשר״, אחרת היא לא תוכל לזכור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはPestoがコピー内容を読み取ってよいかも確認します。「許可」を選ばないと記憶できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS também perguntará se o Pesto pode ler o que você copia. Escolha Permitir, ou ele não poderá lembrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 还会询问是否允许 Pesto 读取你拷贝的内容。请选择“允许”，否则它无法记住内容。"
          }
        }
      }
    },
