    "Templates to begin with. Each fills in the date or time when you paste it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates to begin with. Each fills in the date or time when you paste it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen für den Einstieg. Jede füllt beim Einsetzen Datum oder Uhrzeit aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantillas para empezar. Cada una rellena la fecha o la hora al pegarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des modèles pour démarrer. Chacun insère la date ou l’heure au collage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תבניות להתחלה. כל אחת ממלאת את התאריך או השעה בעת ההדבקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに使えるテンプレートです。ペースト時に日付や時刻を自動で入力します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
