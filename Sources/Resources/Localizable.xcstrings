          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично інсталювати оновлення"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 업데이트 설치"
          }
        },
        "it": {
          "stringUnit": {
