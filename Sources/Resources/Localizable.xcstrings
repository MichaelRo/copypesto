    "Glass shows a little of your desktop. Solid is plain and the same on every desktop.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass shows a little of your desktop. Solid is plain and the same on every desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glas lässt deinen Schreibtisch leicht durchscheinen. Deckend ist schlicht und auf jedem Schreibtisch gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cristal deja ver un poco el escritorio. Sólido es liso e igual en cualquier escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verre laisse entrevoir votre bureau. Uni reste sobre et identique sur chaque bureau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זכוכית חושפת מעט משולחן העבודה. אטום הוא אחיד וזהה בכל שולחן עבודה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラスはデスクトップがわずかに透けます。ソリッドはどのデスクトップでも均一で落ち着いた表示です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidro deixa ver um pouco da mesa. Sólido é uniforme e igual em todas as mesas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玻璃效果会微微透出桌面背景。纯色则在每个桌面上都保持一致。"
          }
        }
      }
    },
    "Goes with the theme. Change it on its own any time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes with the theme. Change it on its own any time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt zum Thema. Du kannst sie jederzeit einzeln ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va a juego con el tema. Cámbialo por separado cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le thème choisi. Modifiable séparément à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תואם לערכת הנושא. ניתן לשנות בנפרד בכל עת."
