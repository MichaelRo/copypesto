    "History clips are not pinned, so your retention setting may remove the older ones.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History clips are not pinned, so your retention setting may remove the older ones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlaufsclips sind nicht angeheftet – ältere werden je nach Aufbewahrungseinstellung entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los clips del historial no están fijados, así que los más antiguos pueden borrarse según tus ajustes de conservación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clips de l’historique ne sont pas épinglés ; votre réglage de conservation peut supprimer les plus anciens."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים בהיסטוריה לא מוצמדים, ולכן הגדרת השמירה עשויה להסיר את הישנים שבהם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴のクリップはピン留めされていないため、保持期間の設定により古いものから削除されることがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipes do histórico não são fixados, então seu ajuste de retenção pode remover os mais antigos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史剪贴未固定，可能会按保留设置自动清理较早的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи из истории не закреплены, поэтому со временем могут удалиться по сроку хранения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кліпи з історії не закріплені, тому параметр зберігання може видаляти старіші."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 클립은 고정되어 있지 않아 보관 설정에 따라 오래된 항목이 지워질 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I clip nella cronologia non sono fissati, quindi la durata impostata può rimuovere i più vecchi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipy z historie nejsou připnuté, takže nastavení uchovávání může starší z nich smazat."
          }
        }
      }
    },
