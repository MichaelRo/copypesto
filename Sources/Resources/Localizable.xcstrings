    "Storage is not available. Restart Pesto and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage is not available. Restart Pesto and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher ist nicht verfügbar. Starte Pesto neu und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento no está disponible. Reinicia Pesto e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage n’est pas disponible. Redémarrez Pesto et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האחסון אינו זמין. הפעילו מחדש את Pesto ונסו שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージを利用できません。Pestoを再起動してやり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento não está disponível. Reinicie o Pesto e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
