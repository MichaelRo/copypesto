    "Sync needs your history, which did not open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync needs your history, which did not open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync benötigt deinen Verlauf, der nicht geöffnet werden konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización necesita tu historial, que no se pudo abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation a besoin de votre historique, qui ne s’est pas ouvert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסנכרון דורש את ההיסטוריה שלך, שלא נפתחה."
          }
        },
        "ja": {
