    "Set a passcode on this device to show hidden clips. Copy still works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a passcode on this device to show hidden clips. Copy still works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege auf diesem Gerät einen Code fest, um ausgeblendete Clips anzuzeigen. Kopieren funktioniert weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un código en este dispositivo para mostrar los clips ocultos. Copiar sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un code sur cet appareil pour afficher les clips masqués. Copier fonctionne toujours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדירו קוד גישה במכשיר זה כדי להציג קטעים מוסתרים. העתקה עדיין עובדת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のクリップを見るにはこのデバイスにパスコードを設定してください。コピーはそのまま使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um código neste dispositivo para ver clipes ocultos. Copiar continua funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在此设备上设置密码以显示隐藏的剪贴。拷贝功能仍可正常使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте код-пароль на устройстве, чтобы открывать скрытые записи. Копирование работает и без него."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте код допуску на цьому пристрої, щоб переглядати приховані кліпи. Копіювання працює й так."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가려진 클립을 보려면 이 기기에 암호를 설정해 주세요. 복사는 그대로 작동해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un codice su questo dispositivo per vedere i clip nascosti. Copia funziona comunque."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zobrazení skrytých klipů nastavte na tomto zařízení přístupový kód. Kopírování dál funguje."
          }
        }
      }
    },
