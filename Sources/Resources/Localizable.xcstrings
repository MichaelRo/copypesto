    "New collections appear automatically until you customize this list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New collections appear automatically until you customize this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las colecciones nuevas aparecen automáticamente hasta que personalices esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles collections apparaissent automatiquement jusqu’à ce que vous personnalisiez cette liste."
          }
