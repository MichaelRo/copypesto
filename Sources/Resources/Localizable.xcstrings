    "%lld clips cannot be opened, so the backup was left as it is.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clip cannot be opened, so the backup was left as it is."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clips cannot be opened, so the backup was left as it is."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Clip konnte nicht geöffnet werden, daher blieb das Backup unverändert."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Clips konnten nicht geöffnet werden, daher blieb das Backup unverändert."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "No se pudo abrir %lld clip, así que la copia de seguridad se dejó intacta."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "No se pudieron abrir %lld clips, así que la copia de seguridad se dejó intacta."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Impossible d’ouvrir %lld clip ; la sauvegarde n’a pas été modifiée."
