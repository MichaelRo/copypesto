    "Your current history cannot be opened on this Mac. Restoring replaces it with this backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current history cannot be opened on this Mac. Restoring replaces it with this backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktueller Verlauf lässt sich auf diesem Mac nicht öffnen. Das Wiederherstellen ersetzt ihn durch dieses Backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir tu historial actual en este Mac. Al restaurar se reemplazará por esta copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre historique actuel ne peut pas être ouvert sur ce Mac. La restauration le remplace par cette sauvegarde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפתוח את ההיסטוריה הנוכחית ב-Mac זה. שחזור יחליף אותה בגיבוי הזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の履歴はこのMacで開けません。復元するとこのバックアップで置き換えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu histórico atual não pode ser aberto neste Mac. Restaurar o substitui por este backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 无法打开当前的历史记录，恢复操作将用此备份替换它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущую историю не удаётся открыть на этом Mac. Восстановление заменит её этой копией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточну історію не вдається відкрити на цьому Mac. Відновлення замінить її цією резервною копією."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 현재 기록을 열 수 없어요. 복원하면 이 백업으로 대체돼요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia attuale non si apre su questo Mac. Il ripristino la sostituirà con questo backup."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši aktuální historii na tomto Macu nelze otevřít. Obnovení ji nahradí touto zálohou."
          }
